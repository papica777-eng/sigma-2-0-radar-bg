---
import ModalsAndDrawer from '../components/modals/ModalsAndDrawer.astro';
import NasvetloLogo from '../components/NasvetloLogo.astro';
import j6Raw from '../../docs/data/sigma3_judicial_6.json';
import adm50Raw from '../../docs/data/nasvetlo_50_admins.json';
import invRaw from '../../docs/data/nasvetlo_investigations.json';
import telkRaw from '../../docs/data/nasvetlo_telk_radar.json';
import eissAuditRaw from '../../docs/data/nasvetlo_eiss_audit.json';

interface Props {
  title?: string;
  description?: string;
  asOf?: string;
  subpage?: boolean;
  canonicalPath?: string;
  subpageScript?: string;
  subpageSyncHref?: string;
  extraJsonLd?: string;
}

const defaultAsOf = [
  String((j6Raw as any).generatedAtUtc || '').slice(0, 10),
  String((adm50Raw as any).generatedAtUtc || '').slice(0, 10),
  String((invRaw as any).generatedAtUtc || '').slice(0, 10),
  String((telkRaw as any).generatedAtUtc || '').slice(0, 10),
  String((eissAuditRaw as any).generatedAtUtc || '').slice(0, 10),
  '2026-11-26',
].filter(Boolean).sort().pop() || '2026-11-26';
const {
  title = 'NAsvetlo — Независима гражданска платформа за прозрачност на обществените поръчки',
  description = 'NAsvetlo (nasvetlo.website) — Независима гражданска платформа, изградена върху отворените данни (CC-BY 4.0) на МИДТ / СИГМА 2.0: €53,22 млрд. (206 907 договора), 4 344 възложители, 17 428 изпълнители, 571 свързани лица, +€1,92 млрд. скрити ДЗЗД, 28-областен атлас, картелна лаборатория, Закон на Бенфорд и жив AI асистент.',
  asOf = defaultAsOf,
  subpage = false,
  canonicalPath = '/',
  subpageScript = 'sigma3/razsledvaniya.js?v=20261123c',
  subpageSyncHref = 'data/nasvetlo_investigations.json',
  extraJsonLd = '',
} = Astro.props;

const canonicalUrl = `https://nasvetlo.website${canonicalPath === '/' ? '/' : canonicalPath}`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://nasvetlo.website/#website',
      url: 'https://nasvetlo.website/',
      name: 'NAsvetlo',
      alternateName: ['На Светло', 'НАсветло', 'nasvetlo.website'],
      inLanguage: 'bg-BG',
      description,
    },
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#app`,
      name: title,
      url: canonicalUrl,
      applicationCategory: 'GovernmentApplication',
      operatingSystem: 'Web',
      inLanguage: 'bg-BG',
      isAccessibleForFree: true,
      license: 'https://opensource.org/licenses/MIT',
      description,
      dateModified: asOf,
    },
    {
      '@type': 'Dataset',
      '@id': `${canonicalUrl}#dataset`,
      name: 'NAsvetlo — Отворен одитен масив за обществени поръчки и публични регистри в България (€53,22 млрд., 206 907 договора)',
      description: 'Кръстосан граждански одитен масив върху отворените данни (CC-BY 4.0) на МИДТ / СИГМА 2.0, АОП / ЦАИС ЕОП, Сметна палата и ЕРИК, КПК, АДФИ, КЗК, ВСС (ЕПЕП/ЕИСС), ВАС, ТРРЮЛНЦ, НОИ и НСИ.',
      url: canonicalUrl,
      creator: {
        '@type': 'Person',
        name: 'Димитър Ставрев Продромов',
        alternateName: 'Dimitar Stavrev Prodromov',
        url: 'https://nasvetlo.website/',
        sameAs: [
          'https://orcid.org/0009-0004-8070-1348',
          'https://github.com/papica777-eng/sigma-2-0-radar-bg',
        ],
      },
      publisher: {
        '@type': 'Organization',
        name: 'NAsvetlo — Независима гражданска платформа',
        url: 'https://nasvetlo.website/',
        logo: {
          '@type': 'ImageObject',
          url: 'https://nasvetlo.website/sigma3/nasvetlo-official-logo.jpg',
        },
      },
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isBasedOn: 'https://sigma.midt.bg/',
      inLanguage: 'bg-BG',
      spatialCoverage: 'Bulgaria',
      temporalCoverage: '2019/2026',
      dateModified: asOf,
      isAccessibleForFree: true,
      distribution: [
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/json',
          contentUrl: 'https://nasvetlo.website/data/nasvetlo_investigations.json',
          name: 'NAsvetlo — Кръстосани разследвания (11 държавни регистъра × ЗОП)',
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/json',
          contentUrl: 'https://nasvetlo.website/data/nasvetlo_telk_radar.json',
          name: 'NAsvetlo — 28-областен ТЕЛК форензик масив (НОИ 2023–2025 × НСИ)',
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/json',
          contentUrl: 'https://nasvetlo.website/data/nasvetlo_oblast_sectors.json',
          name: 'NAsvetlo — Национален корупционен радар по 28 области и 7 сфери (200 338 договора × 22 регистъра)',
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/json',
          contentUrl: 'https://nasvetlo.website/data/nasvetlo_fiscal_edp.json',
          name: 'NAsvetlo — Фискален рентген: Реален дефицит, операции под чертата (F5_ASS) и държавен дълг (Евростат EDP 1/2/3 × МФ × БНБ, 2021–2026)',
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/json',
          contentUrl: 'https://nasvetlo.website/data/nasvetlo_eiss_audit.json',
          name: 'NAsvetlo · От мрак към светлина — Алгоритмичен одит на 2 234 509 дела в ЕПЕП/ЕИСС (2023–2026, 180 съдилища, 3 244 съдии, 869 RED флага)',
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'text/csv',
          contentUrl: 'https://nasvetlo.website/data/SIGMA_2_0_ALL_OFFICIALS_571.csv',
          name: 'NAsvetlo — Свързани длъжностни лица (571 записа, CSV)',
        },
      ],
      keywords: [
        'NAsvetlo',
        'От мрак към светлина',
        'обществени поръчки',
        'СИГМА 2.0',
        'ЦАИС ЕОП',
        'АДФИ',
        'КЗК',
        'Сметна палата',
        'ДЗЗД',
        'ТЕЛК статистика НОИ',
        'съдебен одит ЕИСС',
        'случайно разпределение на дела',
        'ВСС',
        'ИВСС',
        'КПК',
        'ЗСРС',
        'мрежов граф',
        'Benjamini-Hochberg FDR',
        'прозрачност',
        'отворени данни България',
      ],
    },
  ],
});
---
<!DOCTYPE html>
<html lang="bg" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <meta name="google-site-verification" content="neCoTmdGmq7KjXOvpIwzUluRshb3kclW3Ij6cFUSNZA" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="keywords" content="NAsvetlo, На Светло, nasvetlo.website, От мрак към светлина, съдебен одит ЕИСС, обществени поръчки България, СИГМА 2.0, ЦАИС ЕОП, АДФИ, КЗК, Сметна палата, ЕРИК, ЕПЕП, ВАС, ДЗЗД, КПК, ИВСС, антикорупция, прозрачност, отворени данни" />
  <meta name="author" content="NAsvetlo — Независима гражданска платформа" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="bg_BG" />
  <meta property="og:site_name" content="NAsvetlo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content="https://nasvetlo.website/sigma3/og-card.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="NAsvetlo · От мрак към светлина — Национален граждански и съдебен одит на 2 234 509 дела в ЕИСС и €53,22 млрд. по ЗОП" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nasvetlo.website/sigma3/og-card.png" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="bg" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href="https://nasvetlo.website/en/" />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="NAsvetlo · От мрак към светлина (RSS)" href="https://nasvetlo.website/feed.xml" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="https://nasvetlo.website/sitemap.xml" />
  <script type="application/ld+json" set:html={jsonLd} />
  {extraJsonLd && <script type="application/ld+json" set:html={extraJsonLd} />}
  <link rel="icon" type="image/png" href="sigma3/logo-icon.png" />
  <link rel="apple-touch-icon" href="sigma3/nasvetlo-official-logo.jpg" />
  <script is:inline>
    (function() {
      var h = window.location.hostname;
      if (h === 'papica777-eng.github.io' || h === 'paas.website' || h === 'www.paas.website') {
        var p = window.location.pathname.replace(/^\/sigma-2-0-radar-bg(\/|$)/, '/');
        window.location.replace('https://nasvetlo.website' + p + window.location.search + window.location.hash);
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="sigma3/styles.css?v=20261127a" />
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="topbar-left">
      <NasvetloLogo href={subpage ? './' : '#top'} />
    </div>

    <div class="topbar-center">
      {subpage ? (
        <a href="./" class="btn-cmd-center" style="text-decoration:none;justify-content:center;">
          <span>&larr; Към главната платформа NAsvetlo</span>
        </a>
      ) : (
        <button type="button" class="btn-cmd-center" id="openCmdPaletteBtn" title="Бързо глобално търсене (Ctrl+K)">
          <span class="cmd-search-icon" aria-hidden="true">⌕</span>
          <span class="cmd-search-label">Търсене (22 343)</span>
          <kbd>Ctrl K</kbd>
        </button>
      )}
    </div>

    <div class="topbar-right">
      {subpage ? (
        <>
          <button type="button" class="btn topbar-btn" onclick="window.print()">Печат / PDF</button>
          <button type="button" class="btn topbar-btn topbar-btn-theme" id="themeToggleBtn" title="Превключи между Светъл и Тъмен режим">Тъмен режим</button>
        </>
      ) : (
        <>
          <button type="button" class="btn topbar-btn-ai" id="quickOpenOracleBtn">AI Асистент</button>
          <button type="button" class="btn topbar-btn" id="densityToggleBtn" title="Превключи между компактен одиторски изглед и презентационен изглед">Одиторски изглед</button>
          <button type="button" class="btn topbar-btn topbar-btn-theme" id="themeToggleBtn" title="Превключи между Светъл и Тъмен режим">Тъмен режим</button>
          <a href="telk-skener.html" class="btn topbar-btn-telk" title="Интерактивно демо на платформата за проверка на ТЕЛК решения — оферта за безвъзмездно дарение на държавата по ССЕВ">ТЕЛК Скенер (Демо) ↗</a>
          <a href="ot-mrak-kam-svetlina.html" class="btn topbar-btn-svetlina" title="От мрак към светлина — алгоритмичен одит на 2 234 509 дела в ЕИСС, 28-областен съдебен радар и 869 RED флага (154 необяснени)">От мрак към светлина ↗</a>
          <a href="razsledvaniya.html" class="btn topbar-btn-inv" title="Кръстосани разследвания по държавни регистри и Индекс на институционалната прозрачност">Нови разследвания ↗</a>
        </>
      )}
    </div>
  </div>
</header>

<div class="info-subbar">
  <div class="info-subbar-inner">
    <div class="info-subbar-meta">
      <span class="civic-positioning-tag">Независима гражданска платформа върху отворените данни (CC-BY 4.0) на МИДТ / СИГМА 2.0</span>
      <span class="info-subbar-sep" aria-hidden="true">·</span>
      <a class="info-subbar-sync" id="syncSubtitle" href={subpage ? subpageSyncHref : 'data/sigma3_judicial_6.json'} target="_blank" rel="noopener" title="Преглед на актуалния JSON лог на последната синхронизация">Синхронизация: {asOf}</a>
    </div>
    <div class="info-subbar-links">
      <span class="info-subbar-visits" id="nasvetloVisitCounter" title="Общ постоянен брой посещения на nasvetlo.website (не се занулява)" hidden style="display:none;"></span>
      <span class="info-subbar-sep" id="nasvetloVisitSep" aria-hidden="true" hidden style="display:none;"></span>
      {subpage ? (
        <>
          <a class="subbar-link" href="/en/">EN · EPPO Brief</a>
          <a class="subbar-link" href="data/nasvetlo_telk_radar.json" download>ТЕЛК 28-областен JSON</a>
          <a class="subbar-link" href="data/nasvetlo_50_admins.json" download>Индекс JSON</a>
          <a class="subbar-link" href="data/nasvetlo_investigations.json" download>Разследвания JSON</a>
          <a class="subbar-link" href="https://sigma.midt.bg" target="_blank" rel="noopener">СИГМА 2.0 ↗</a>
        </>
      ) : (
        <>
          <a class="subbar-link" href="/en/">EN · EPPO Brief</a>
          <button type="button" class="subbar-link-btn" id="quickOpenProposalBtn">Архитектура &amp; Методология</button>
          <a class="subbar-link" href="data/SIGMA_2_0_ALL_OFFICIALS_571.csv" download>CSV</a>
          <a class="subbar-link" href="https://sigma.midt.bg" target="_blank" rel="noopener">СИГМА 2.0 ↗</a>
        </>
      )}
    </div>
  </div>
</div>

<main class="container">
  <slot />
</main>

<footer class="site-footer">
  <span><strong>NAsvetlo</strong> (<a href="https://nasvetlo.website">nasvetlo.website</a>) · Независима гражданска платформа, изградена върху отворените данни (CC-BY 4.0) на МИДТ / СИГМА 2.0 и първичните регистри (2026): АОП / ЦАИС ЕОП, Сметна палата &amp; ЕРИК, КПК, АДФИ, КЗК, ВСС — ЕПЕП / ЕИСС &amp; ВАС, ТРРЮЛНЦ, EPPO · Карта: GISCO NUTS 2021 © EuroGeographics</span>
  <span style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;">
    <span class="footer-visits" id="nasvetloFooterVisits" title="Постоянен брояч на посещенията (без нулиране)" hidden style="display:none;"></span>
    <a href="ot-mrak-kam-svetlina.html">От мрак към светлина</a>
    <a href="/en/">English Brief (EPPO / EU)</a>
    <a href="https://sigma.midt.bg" target="_blank" rel="noopener">sigma.midt.bg</a>
    <a href="https://sigma-budget.midt.bg" target="_blank" rel="noopener">СИГМА Бюджет</a>
    <a href="https://ecase.justice.bg" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">ЕПЕП / ЕИСС</a>
    <a href="https://adfi.minfin.bg" target="_blank" rel="noopener">АДФИ</a>
    <a href="https://reg.cpc.bg" target="_blank" rel="noopener">КЗК</a>
    <a href="https://github.com/papica777-eng/sigma-2-0-radar-bg" target="_blank" rel="noopener">Отворен код</a>
  </span>
</footer>

{subpage ? (
  <script is:inline src={subpageScript}></script>
) : (
  <>
    <ModalsAndDrawer />

    <script is:inline src="sigma3/app.js?v=20261124b"></script>
    <script is:inline src="sigma3/semantic_dialog_engine.js?v=20261122f"></script>
    <script is:inline src="sigma3/sigma3_modules.js?v=20261124b"></script>
    <script is:inline src="sigma3/forensics7.js?v=20261124c"></script>
    <script is:inline src="sigma3/judicial6.js?v=20261123c"></script>
  </>
)}
</body>
</html>
