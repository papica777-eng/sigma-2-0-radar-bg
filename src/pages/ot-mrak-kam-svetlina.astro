  { court: 'СГС · Търговско (2026)', party: 'ЗАД ОЗК – Застраховане АД (121265177)', judge: 'Весела Живкова-Офицерска', kn: '4 / 9 (44,4%)', mult: '×10,42', level: 'AMBER' },
  { court: 'СРС · Гражданско (2025)', party: 'Топлофикация София ЕАД (831609046)', judge: 'Нора Владимирова Маринова', kn: '43 / 314', mult: '×4,87', level: 'RED' },
  { court: 'СРС · Гражданско (2025)', party: 'ЗК Лев Инс АД (121130788)', judge: 'Нора Владимирова Маринова', kn: '10 / 42', mult: '×8,46', level: 'RED' },
  { court: 'СРС · Гражданско (2025)', party: 'ДЗИ – Общо застраховане ЕАД (121718407)', judge: 'Нора Владимирова Маринова', kn: '8 / 29', mult: '×9,80', level: 'RED' },
  { court: 'СРС · Гражданско (2025)', party: 'ЗАД Армеец АД (121076907)', judge: 'Стойчо Тодоров Попов', kn: '6 / 24', mult: '×13,68', level: 'RED' },
  { court: 'СРС · Гражданско (2025)', party: 'ЗАД ДаллБогг: Живот и Здраве АД (200299615)', judge: 'Стойчо Тодоров Попов', kn: '7 / 40', mult: '×9,57', level: 'RED' },
  { court: 'СРС · Частно гр. (2025)', party: 'А1 България ЕАД (131468980)', judge: 'Андрей Красимиров Георгиев', kn: '14 / 36', mult: '×16,33', level: 'RED' },
  { court: 'СРС · Частно гр. (2025)', party: 'Банка ДСК АД (121830616)', judge: 'Мария Валентинова Атанасова', kn: '6 / 308', mult: '×60,02', level: 'RED' },
  { court: 'СРС · Частно гр. (2025)', party: 'Първа инвестиционна банка АД (831094393)', judge: 'Цветомила Данова', kn: '4 / 87', mult: '×35,41', level: 'AMBER' },
  { court: 'РС–Габрово · ЧГД (2025)', party: 'Софийска вода АД (130175000)', judge: 'Пламен Пантев Денев', kn: '5 / 42', mult: '×23,34', level: 'RED' },
