                <td>{c.owner}</td>
                <td class="mono"><strong>{c.zop}</strong></td>
                <td style="color:var(--crimson);font-weight:600;">{c.annex}</td>
                <td>{c.court}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLE 5: EPPO HIGH-RISK EU CONTRACTS, GOVERNMENT LAW FIRMS & MVR SECURITY LICENSES -->
    <section class="svetlina-section" data-svet-section="eppo">
      <div class="svetlina-section-head">
        <h2>V. Европроекти с 1 оферта (&euro;1,58 млрд.), концентрация на правни услуги (J3) и ЗЧОД без активен лиценз</h2>
        <span class="mono" style="font-size:0.74rem;color:var(--ink-muted);">Регламент (ЕС) 2017/1939 · МВР Регистър ЗЧОД</span>
      </div>
      <div class="table-wrap svetlina-compact-scroll">
        <table>
          <thead>
            <tr>
              <th>Ресор</th>
              <th>Категория</th>
              <th>Възложител &rarr; Изпълнител (ЕИК)</th>
              <th>Стойност (€)</th>
              <th>Констатирано отклонение и правно основание</th>
            </tr>
          </thead>
          <tbody>
            {eppoLawSecurityRows.map((e) => (
              <tr data-sector={e.sector}>
                <td><span class="svetlina-badge is-indigo">{e.sectorLabel}</span></td>
                <td><span class="svetlina-badge is-amber">{e.cat}</span></td>
                <td><strong>{e.name}</strong></td>
                <td class="mono"><strong>{e.val}</strong></td>
                <td>{e.details}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- METHODOLOGY & LEGAL NOTE -->
    <section class="svetlina-method" aria-label="Методология и правна бележка">
      <div class="svetlina-method-col">
        <h3>Методология</h3>
        <ul>
          <li><strong>Съдебно разпределение:</strong> едностранен биномен тест за всяка двойка „страна → съдия“ спрямо реалния дял на съдията в отделението; корекция за множествени сравнения по Benjamini–Hochberg (FDR). RED флаг: q &lt; 0,01, k ≥ 5, кратност ≥ 3.</li>
          <li><strong>Обществени поръчки:</strong> 206 907 договора от ЦАИС ЕОП, кръстосани с ТРРЮЛНЦ, регистъра на действителните собственици (ЗМИП) и 3 035 декларации в КПКОНПИ.</li>
          <li><strong>Контролни органи:</strong> публични актове на АДФИ, КЗК/ВАС и регистъра на ЗЧОД на МВР.</li>
        </ul>
      </div>
      <div class="svetlina-method-col">
        <h3>Правна бележка</h3>
        <p>
          Представените индикатори са статистически и регистърни сигнали за повишен риск, изведени изцяло от публично достъпни
          официални източници. Те не представляват констатация за извършено нарушение или престъпление и не заместват
          проверката на компетентните органи. За всички посочени лица важи презумпцията за невиновност.
        </p>
        <p class="svetlina-method-meta">Данни към {asOf} · Отворени данни CC-BY 4.0 · Без ЕГН и лични данни на физически лица</p>
      </div>
    </section>
