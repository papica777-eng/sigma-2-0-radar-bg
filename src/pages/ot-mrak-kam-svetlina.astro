---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import eissAuditRaw from '../../docs/data/nasvetlo_eiss_audit.json';
import j6Raw from '../../docs/data/sigma3_judicial_6.json';
import macroRaw from '../../docs/data/sigma3_macro.json';

const fmtInt = (n: number) => Number(n || 0).toLocaleString('bg-BG');
const fmtEurShort = (n: number) => {
  const v = Number(n || 0);
  if (v >= 1e9) return `€${(v / 1e9).toFixed(2).replace('.', ',')} млрд.`;
  if (v >= 1e6) return `€${(v / 1e6).toFixed(2).replace('.', ',')} млн.`;
  return `€${Math.round(v).toLocaleString('bg-BG')}`;
};

const cleanParty = (p: string) =>
  String(p || '')
    .replace(/АДМИТИСТРАЦИЯ/gi, 'АДМИНИСТРАЦИЯ')
    .replace(/\s*\(\s*\)/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const audit = eissAuditRaw as any;
const u = audit.universe || {};
const tierCounts = u.tierCounts || {};
const unexplainedRedTotal = Number(u.unexplainedRedTotal || 0);
const statutoryRedTotal = Number(u.statutoryRedTotal || 0);
const batchArtifactRedTotal = Number(u.batchArtifactRedTotal || 0);
const massCreditorRedTotal = Number(u.massCreditorRedTotal || 0);
const datasetSha256 = String(u.datasetSha256 || '');
const lawyerJudgeFlags: any[] = audit.lawyerJudgeFlags || [];
const multiFlagJudgeHubs: any[] = audit.multiFlagJudgeHubs || [];
const conflictBridge: any[] = audit.conflictBridge || [];
const multiYearPersistent: any[] = audit.multiYearPersistent || [];
const multiYearUnexplainedTotal = Number(u.multiYearUnexplainedTotal || 0);
const linkedOfficialsTotal = Number(u.linkedOfficialsTotal || 0);
const yearsList: number[] = Array.isArray(u.years) && u.years.length ? u.years : [2024, 2025, 2026];
const yearRangeLabel = yearsList.length >= 2 ? `${yearsList[0]}–${yearsList[yearsList.length - 1]}` : String(yearsList[0] || '2026');
const totalCasesFmt = fmtInt(u.casesUnique || 1695046);
const totalJudgesFmt = fmtInt(u.judges || 2998);
const totalCourtsFmt = fmtInt(u.courts || 180);
const TIER_UI: Record<string, { short: string; cls: string; rank: number }> = {
  UNEXPLAINED_PRIORITY: { short: 'Необяснено · ИВСС', cls: 'is-crimson', rank: 1 },
  MASS_CREDITOR_SUMMARY: { short: 'Масов ищец (ГПК)', cls: 'is-ochre', rank: 2 },
  BATCH_FILING_ARTIFACT: { short: 'Пакетно (1–2 д.)', cls: 'is-navy', rank: 3 },
  STATUTORY_PUBLIC_SPECIALIZED: { short: 'Публ. специализация', cls: 'is-indigo', rank: 4 },
  STATUTORY_ZSRS_DUTY: { short: 'ЗСРС / Дежурен', cls: 'is-teal', rank: 5 },
};
const j6 = j6Raw as any;
const m3 = j6.module3_legalExpertGraph || {};
const macro = macroRaw as any;
const mapGeo = macro.mapGeo || { viewBox: '0 0 1000 660', oblasts: [] };
const asOf = String(audit.generatedAtUtc || '2026-11-26').slice(0, 10);

// Map every Bulgarian court (180 courts in EISS) to its exact NUTS-3 oblast
function mapCourtToNuts3(courtName: string): string {
  const s = String(courtName || '').toLowerCase();
  if (
    s.includes('софийски окръжен') ||
    s.includes('софия-област') ||
    s.includes('ботевград') ||
    s.includes('елин пелин') ||
    s.includes('етрополе') ||
    s.includes('ихтиман') ||
    s.includes('костинброд') ||
    s.includes('пирдоп') ||
    s.includes('самоков') ||
    s.includes('своге') ||
    s.includes('сливница')
  ) {
    return 'BG412';
  }
  if (
    s.includes('софийски районен') ||
    s.includes('софийски градски') ||
    s.includes('софия-град') ||
    s.includes('апелативен съд - софия') ||
    s.includes('военен съд - софия') ||
    s.includes('военно-апелативен') ||
    s.includes('върховен касационен') ||
    s.includes('върховен административен')
  ) {
    return 'BG411';
  }
  if (s.includes('благоевград') || s.includes('гоце делчев') || s.includes('петрич') || s.includes('разлог') || s.includes('сандански')) return 'BG413';
  if (s.includes('перник') || s.includes('брезник') || s.includes('радомир') || s.includes('трън')) return 'BG414';
  if (s.includes('кюстендил') || s.includes('дупница')) return 'BG415';
  if (s.includes('видин') || s.includes('белоградчик') || s.includes('кула')) return 'BG311';
  if (s.includes('монтана') || s.includes('берковица') || s.includes('лом')) return 'BG312';
  if (s.includes('враца') || s.includes('бяла слатина') || s.includes('козлодуй') || s.includes('мездра') || s.includes('оряхово')) return 'BG313';
  if (s.includes('плевен') || s.includes('кнежа') || s.includes('левски') || s.includes('никопол') || s.includes('червен бряг')) return 'BG314';
  if (s.includes('ловеч') || s.includes('луковит') || s.includes('тетевен') || s.includes('троян')) return 'BG315';
  if (s.includes('велико търново') || s.includes('горна оряховица') || s.includes('елена') || s.includes('павликени') || s.includes('свищов')) return 'BG321';
  if (s.includes('габрово') || s.includes('дряново') || s.includes('севлиево') || s.includes('трявна')) return 'BG322';
  if (s.includes('русе') || s.includes('бяла')) return 'BG323';
  if (s.includes('разград') || s.includes('исперих') || s.includes('кубрат')) return 'BG324';
  if (s.includes('силистра') || s.includes('дулово') || s.includes('тутракан')) return 'BG325';
  if (s.includes('варна') || s.includes('девня') || s.includes('провадия')) return 'BG331';
  if (s.includes('добрич') || s.includes('балчик') || s.includes('тошево') || s.includes('каварна') || s.includes('тервел')) return 'BG332';
  if (s.includes('шумен') || s.includes('велики преслав') || s.includes('нови пазар')) return 'BG333';
  if (s.includes('търговище') || s.includes('омуртаг') || s.includes('попово')) return 'BG334';
  if (s.includes('бургас') || s.includes('айтос') || s.includes('карнобат') || s.includes('малко търново') || s.includes('несебър') || s.includes('поморие') || s.includes('средец') || s.includes('царево')) return 'BG341';
  if (s.includes('сливен') || s.includes('котел') || s.includes('нова загора')) return 'BG342';
  if (s.includes('ямбол') || s.includes('елхово')) return 'BG343';
  if (s.includes('стара загора') || s.includes('гълъбово') || s.includes('казанлък') || s.includes('раднево') || s.includes('чирпан')) return 'BG344';
  if (s.includes('пловдив') || s.includes('асеновград') || s.includes('карлово') || s.includes('първомай')) return 'BG421';
  if (s.includes('хасково') || s.includes('димитровград') || s.includes('ивайловград') || s.includes('свиленград') || s.includes('тополовград') || s.includes('харманли')) return 'BG422';
  if (s.includes('пазарджик') || s.includes('велинград') || s.includes('панагюрище') || s.includes('пещера')) return 'BG423';
  if (s.includes('смолян') || s.includes('девин') || s.includes('златоград') || s.includes('мадан') || s.includes('чепеларе')) return 'BG424';
  if (s.includes('кърджали') || s.includes('ардино') || s.includes('крумовград') || s.includes('момчилград')) return 'BG425';
  return 'BG411';
}

// Aggregate all 180 courts and 869 RED flags into the 28 Bulgarian NUTS-3 Oblasts
const oblastBuckets: Record<string, any> = {};
(mapGeo.oblasts || []).forEach((ob: any) => {
  oblastBuckets[ob.nuts3] = {
    nuts3: ob.nuts3,
    name: ob.name,
    nuts2Name: ob.nuts2Name || '',
    d: ob.d,
    cx: ob.cx,
    cy: ob.cy,
    courtsCount: 0,
    cases: 0,
    judges: 0,
    redFlags: 0,
    unexplainedRed: 0,
    amberFlags: 0,
    maxRatio: 0,
    ratePer10k: 0,
    courts: [] as any[],
    topFlags: [] as any[],
  };
});

(audit.courts || []).forEach((c: any) => {
  const n3 = mapCourtToNuts3(c.courtName);
  const b = oblastBuckets[n3];
  if (!b) return;
  b.courtsCount += 1;
  b.cases += Number(c.cases || 0);
  b.judges += Number(c.judges || 0);
  b.redFlags += Number(c.redFlags || 0);
  b.unexplainedRed += Number(c.unexplainedRedFlags || 0);
  b.amberFlags += Number(c.amberFlags || 0);
  b.courts.push({
    name: c.courtName,
    cases: Number(c.cases || 0),
    judges: Number(c.judges || 0),
    red: Number(c.redFlags || 0),
    unexplainedRed: Number(c.unexplainedRedFlags || 0),
    amber: Number(c.amberFlags || 0),
    gini: Number(c.medianGini || 0),
  });
});

const allRedFlagsList: any[] = [];
(audit.redFlags || []).forEach((rf: any, idx: number) => {
  const n3 = mapCourtToNuts3(rf.courtName);
  const b = oblastBuckets[n3];
  const ratio = Number(rf.ratio || 0);
  const tier = String(rf.explanationTier || 'UNEXPLAINED_PRIORITY');
  const tierUi = TIER_UI[tier] || TIER_UI.UNEXPLAINED_PRIORITY;
  const flagObj = {
    idx: idx + 1,
    nuts3: n3,
    oblastName: b ? b.name : 'София (столица)',
    court: rf.courtName,
    kind: rf.caseKind,
    year: rf.year,
    party: cleanParty(rf.party),
    eik: rf.partyEik || '',
    judge: rf.judge,
    k: rf.k,
    n: rf.nParty,
    exp: Number(rf.expected || 0),
    ratio,
    q: rf.q,
    tier,
    tierRank: tierUi.rank,
    tierShort: tierUi.short,
    tierCls: tierUi.cls,
    tierLabel: rf.explanationLabel || tierUi.short,
    basis: rf.explanationBasis || '',
    distinctDays: Number(rf.distinctDays || 0),
    distinctMonths: Number(rf.distinctMonths || 0),
    maxDayShare: Number(rf.maxDayShare || 0),
    dateSpan: rf.dateSpan || '',
    restrictedShare: Number(rf.restrictedShare || 0),
    procEur: Math.round(Number(rf.procurementEurM || 0) * 1e6),
    procContracts: Number(rf.procurementContracts || 0),
    caseUrl: rf.sampleCases && rf.sampleCases[0] ? rf.sampleCases[0].caseUrl : '',
    caseRef: rf.sampleCases && rf.sampleCases[0] ? `${rf.sampleCases[0].regNumber}/${rf.sampleCases[0].regYear}` : '',
  };
  allRedFlagsList.push(flagObj);
  if (!b) return;
  if (ratio > b.maxRatio) b.maxRatio = ratio;
  b.topFlags.push(flagObj);
});

allRedFlagsList.sort((a, b) => a.tierRank - b.tierRank || a.q - b.q || b.ratio - a.ratio);
allRedFlagsList.forEach((item, i) => {
  item.idx = i + 1;
});
Object.values(oblastBuckets).forEach((b: any) => {
  b.topFlags.sort((a: any, c: any) => a.tierRank - c.tierRank || a.q - c.q || c.ratio - a.ratio);
});

const redKindsUnique = Array.from(new Set(allRedFlagsList.map((r) => r.kind))).sort();

const judicialOblasts = Object.values(oblastBuckets).map((b: any) => {
  b.courts.sort((a: any, c: any) => c.red - a.red || c.amber - a.amber || c.cases - a.cases);
  b.ratePer10k = b.cases > 0 ? Number(((b.redFlags / b.cases) * 10000).toFixed(2)) : 0;
  b.maxRatio = Number(b.maxRatio.toFixed(2));
  return b;
});

const judicialMapConfig = {
  viewBox: mapGeo.viewBox || '0 0 1000 660',
  oblasts: judicialOblasts,
};

