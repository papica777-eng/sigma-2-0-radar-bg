              <tr data-sector={s.sector}>
                <td><span class="svetlina-badge is-indigo">{s.sectorLabel}</span></td>
                <td>{s.court}</td>
                <td><strong>{s.party}</strong></td>
                <td><strong>{s.judge}</strong></td>
                <td class="mono"><strong>{s.kn}</strong></td>
                <td class="mono" style="color:var(--crimson);font-weight:700;">{s.mult}</td>
                <td class="mono">{s.q}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLE 4: ROAD CONSTRUCTION CARTEL, ANNEX INFLATION & ZMIP BENEFICIAL OWNER GAPS -->
    <section class="svetlina-section" data-svet-section="cartel">
      <div class="svetlina-section-head">
        <h2>IV. Пътно строителство, увеличения чрез анекси (+&euro;1,29 млрд.), търговски дела (J1) и липсващ действителен собственик по ЗМИП (&euro;2,99 млрд.)</h2>
        <span class="mono" style="font-size:0.74rem;color:var(--ink-muted);">ЦАИС ЕОП &times; ТРРЮЛНЦ &times; ЕИСС Търговски отделения</span>
      </div>
      <div class="table-wrap svetlina-compact-scroll">
        <table>
          <thead>
            <tr>
              <th>Ресор</th>
              <th>Изпълнител (ЕИК)</th>
