    <!-- NEW: 6 MINISTRY & SECTOR NAVIGATOR CARDS (CLICK TO FILTER BY MINISTRY WITHOUT SCROLLING) -->
    <section class="svetlina-sector-deck" aria-label="Разпределение по министерства и дейност">
      <div class="svetlina-sector-header">
        <div>
          <h2 class="svetlina-sector-title">Навигатор по Министерства, Ведомства и Сектор на дейност</h2>
          <p class="svetlina-sector-sub">
            Избери ресор, за да видиш само замесените в него политици, фирми, договори и съдии на един екран — без излишно скролване.
          </p>
        </div>
        <button type="button" class="btn topbar-btn" data-svet-sector="all" id="svetlinaAllSectorsBtn">
          Покажи всички 6 ресора едновременно
        </button>
      </div>

      <div class="svetlina-sector-grid" role="tablist" aria-label="Избор на министерство или ресор">
        {ministrySectors.map((m, idx) => (
          <button
            type="button"
            class={`svetlina-sector-card accent-${m.accent} ${idx === 0 ? 'active' : ''}`}
