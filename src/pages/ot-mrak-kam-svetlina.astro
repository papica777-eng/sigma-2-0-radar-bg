  <!-- UNIVERSAL SLIDE-OVER RIGHT DOSSIER & DEPENDENCY CHAIN DRAWER -->
  <div class="drawer-backdrop" id="svetDrawerBackdrop" aria-hidden="true"></div>
  <aside
    class="drawer svetlina-drawer"
    id="svetDrawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="svetDrawerTitle"
    aria-hidden="true"
  >
    <div class="svet-drawer-nav" id="svetDrawerNav" hidden>
      <button type="button" class="svet-back-btn" id="svetDrawerBack">&larr; Назад по веригата</button>
      <div class="svet-breadcrumbs" id="svetDrawerBreadcrumbs"></div>
    </div>
    <div class="drawer-header">
      <div style="min-width:0;flex:1;">
        <div class="kpi-label" id="svetDrawerKicker">ДОСИЕ И ПРОСЛЕДЯВАНЕ НА ЗАВИСИМОСТИ</div>
        <div class="drawer-title-h2" id="svetDrawerTitle" role="heading" aria-level="2">Зареждане...</div>
        <div class="badges" id="svetDrawerBadges"></div>
      </div>
      <button type="button" class="close-btn" id="svetDrawerClose" aria-label="Затвори">&times;</button>
    </div>
    <div class="drawer-body" id="svetDrawerBody"></div>
  </aside>

  <!-- 1-CLICK CITIZEN & JOURNALIST SIGNAL MODAL (АПК / ИВСС / АДФИ / EPPO) -->
  <div class="svet-signal-backdrop" id="svetSignalBackdrop" hidden></div>
  <section
    class="svet-signal-modal"
    id="svetSignalModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="svetSignalModalTitle"
    hidden
  >
    <div class="svet-signal-head">
      <div>
        <div class="svet-signal-kicker">ГРАЖДАНСКИ И ЖУРНАЛИСТИЧЕСКИ ИНСТРУМЕНТ · ГЛАВА VIII АПК</div>
        <h3 id="svetSignalModalTitle">Генератор на официален сигнал</h3>
      </div>
      <button type="button" class="drawer-close" id="svetSignalCloseBtn" aria-label="Затвори генератора">&times;</button>
    </div>

    <div class="svet-signal-tabs" role="tablist" aria-label="Избор на адресат">
      <button type="button" class="svet-signal-tab active" data-svet-signal-authority="ivss">
        ИВСС · Случайно разпределение (чл. 54 ЗСВ)
      </button>
      <button type="button" class="svet-signal-tab" data-svet-signal-authority="adfi">
        АДФИ / КПК · ЗОП и конфликт на интереси
      </button>
      <button type="button" class="svet-signal-tab" data-svet-signal-authority="eppo">
        EPPO / OLAF · European Funds Signal (EN)
      </button>
    </div>

    <div class="svet-signal-meta" id="svetSignalMeta"></div>

    <label for="svetSignalText" class="sr-only">Текст на сигнала</label>
    <textarea class="svet-signal-textarea mono" id="svetSignalText" rows="16"></textarea>

    <div class="svet-signal-actions">
      <button type="button" class="btn btn-dark" id="svetSignalCopyBtn">Копирай сигнала</button>
      <button type="button" class="btn" id="svetSignalDownloadBtn">Изтегли .TXT</button>
      <button type="button" class="btn" id="svetSignalPrintBtn">Принтирай / PDF (A4)</button>
      <button type="button" class="btn" id="svetSignalCancelBtn">Затвори</button>
      <span class="svet-copy-toast" id="svetSignalToast" hidden>Готово — копирано в клипборда</span>
    </div>
  </section>

  <script type="application/json" id="svetlinaGraphPayload" set:html={graphPayloadJson}></script>
  <script defer src="sigma3/nasvetlo_verifier.js?v=20261127c"></script>
</BaseLayout>
