            data-svet-sector-title={m.title}
          >
            <div class="sec-card-top">
              <span class="sec-card-code">{m.code}</span>
              <span class="sec-card-eur">{m.eur}</span>
            </div>
            <div class="sec-card-title">{m.title}</div>
            <div class="sec-card-badges">{m.badges}</div>
            <p class="sec-card-desc">{m.summary}</p>
          </button>
        ))}
      </div>
    </section>

    <!-- COMPACT COMMAND BAR: ACTIVE SECTOR BANNER + SEARCH + REGISTER TABS -->
    <div class="eiss-filter-bar" role="search" style="flex-direction:column;align-items:stretch;gap:9px;margin-bottom:10px;">
      <div class="svetlina-active-banner">
        <div>
          <span class="active-kicker">АКТИВЕН РЕСОР:</span>
          <strong id="svetlinaActiveSectorName">Ресор 01 · МРРБ, АПИ и пътна инфраструктура (€3,84 млрд.)</strong>
        </div>
        <span class="eiss-filter-count" id="svetlinaSearchStatus"></span>
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
        <input
          type="search"
          id="svetlinaSearchInput"
          placeholder="Търси в избрания ресор (или във всички) по име, министерство, фирма, ЕИК, съдия, съд или УНП..."
          aria-label="Търсене в таблиците"
        />
        <button type="button" class="btn topbar-btn" id="svetlinaResetBtn">Нулирай към Ресор 1 (МРРБ)</button>
      </div>

      <div class="quick-cities" style="margin:0;">
        <span>Бърз фокус:</span>
        <button type="button" class="city-chip" data-svet-quick="Главболгарстрой">Главболгарстрой / Цеков</button>
        <button type="button" class="city-chip" data-svet-quick="Кюмюрджиев">КЗК / Химимпорт</button>
        <button type="button" class="city-chip" data-svet-quick="Лев Инс">Лев Инс / ДКК</button>
        <button type="button" class="city-chip" data-svet-quick="ДаллБогг">ДаллБогг / Армеец</button>
        <button type="button" class="city-chip" data-svet-quick="Руси Алексиев">СГС Руси Алексиев</button>
        <button type="button" class="city-chip" data-svet-quick="Бургас">Бургас (100% ЧНД)</button>
        <button type="button" class="city-chip" data-svet-quick="Хасково">Хасково (Гаргов / EPPO)</button>
        <button type="button" class="city-chip" data-svet-quick="hasZmipBo">Без действителен собственик (ЗМИП)</button>
      </div>
    </div>

    <div class="inv-tabs" id="svetlinaTabBar" role="tablist" aria-label="Филтър по тип регистър">
      <button type="button" class="inv-tab-btn active" data-svet-tab="all">Всички таблици за избрания ресор</button>
      <button type="button" class="inv-tab-btn" data-svet-tab="politicians">1. Политици, Бордове &amp; ДЗЗД <span class="inv-tab-count">{politicians.length}</span></button>
      <button type="button" class="inv-tab-btn" data-svet-tab="corp">2. Корпоративни и Банкови дела <span class="inv-tab-count">{corpFlags.length}</span></button>
      <button type="button" class="inv-tab-btn" data-svet-tab="security">3. Силови ЧНД, НАП, НЕЛК &amp; КЕВР <span class="inv-tab-count">{securityFlags.length}</span></button>
      <button type="button" class="inv-tab-btn" data-svet-tab="cartel">4. Строителство, анекси &amp; ЗМИП <span class="inv-tab-count">{cartelZmipRows.length}</span></button>
      <button type="button" class="inv-tab-btn" data-svet-tab="eppo">5. EPPO, Адвокати &amp; ЗЧОД <span class="inv-tab-count">{eppoLawSecurityRows.length}</span></button>
    </div>

    <!-- TABLE 1: POLITICIANS, REGULATORS & LOCAL FEUDALS -->
    <section class="svetlina-section" data-svet-section="politicians">
      <div class="svetlina-section-head">
        <h2>I. Политически лица, бивши министри, депутати, регулатори и местна власт (КПКОНПИ &times; ТР &times; ЕИСС &times; EPPO)</h2>
        <span class="mono" style="font-size:0.74rem;color:var(--ink-muted);">3 035 XML декларации · 338 скрити ДЗЗД</span>
      </div>
      <div class="table-wrap svetlina-compact-scroll">
        <table>
          <thead>
            <tr>
              <th>Ресор</th>
              <th>Риск</th>
              <th>Лице</th>
              <th>Длъжност / Институция</th>
              <th>Свързана компания (ЕИК)</th>
              <th>ЗОП &amp; ДЗЗД обем</th>
              <th>Крос-регистърно засичане (ЕИСС / КЗК / ЗМИП / EPPO)</th>
            </tr>
          </thead>
          <tbody>
            {politicians.map((p) => (
              <tr data-sector={p.sector}>
                <td><span class="svetlina-badge is-indigo">{p.sectorLabel}</span></td>
                <td>
                  <span class="svetlina-badge is-red">{p.risk}/100</span>
                  <div class="svetlina-cell-bar"><span style={`width:${p.risk}%;`}></span></div>
                </td>
                <td><strong>{p.name}</strong></td>
                <td>{p.role}</td>
                <td>{p.company}</td>
                <td class="mono"><strong>{p.eur}</strong></td>
                <td>{p.signal}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLE 2: CORPORATE, INSURANCE & BANKING MONOPOLIES IN EISS -->
    <section class="svetlina-section" data-svet-section="corp">
      <div class="svetlina-section-head">
        <h2>II. Корпоративни, застрахователни, банкови и комунални концентрации в ЕИСС (&euro;3,40 млрд. ЗОП капитал)</h2>
        <span class="mono" style="font-size:0.74rem;color:var(--ink-muted);">Едностранен биномен тест · Benjamini–Hochberg FDR</span>
      </div>
      <div class="table-wrap svetlina-compact-scroll">
        <table>
          <thead>
            <tr>
              <th>Ресор</th>
              <th>Флаг</th>
              <th>Съд и отделение</th>
              <th>Юридическо лице / Институция (ЕИК)</th>
              <th>Съдия-докладчик</th>
              <th>Разпределени (k / n)</th>
              <th>Очаквани</th>
              <th>Кратност</th>
              <th>FDR q</th>
            </tr>
          </thead>
          <tbody>
            {corpFlags.map((f) => (
              <tr data-sector={f.sector}>
                <td><span class="svetlina-badge is-indigo">{f.sectorLabel}</span></td>
