  { court: 'СГС · ЧНД (2025 / 2026)', party: 'ДАНС (129009710)', judge: 'Руси Алексиев (Предс. СГС)', kn: '166/245 · 103/194', mult: '×5,02 / ×11,52' },
  { court: 'СГС · ЧНД (2026)', party: 'Дирекция „Вътрешна сигурност“ – МВР', judge: 'Руси Алексиев (Предс. СГС)', kn: '28 / 33 (84,8%)', mult: '×18,41' },
  { court: 'РС–Бургас · ЧНД (2025 / 2026)', party: 'ОДМВР – Бургас', judge: 'Евгени Узунов (Предс. РС)', kn: '89/124 · 69/92', mult: '×10,86 / ×10,99' },
  { court: 'ОС–Бургас · ЧНД (2025 / 2026)', party: 'ГДГП / ДВС–МВР / ОДМВР–Бургас', judge: 'Даниел Марков (Зам.-предс. ОС)', kn: '18/18 (100%) · 12/13 · 37/55', mult: '×7,37 / ×6,54' },
  { court: 'ОС–Бургас · ЧНД (2026)', party: 'ОДМВР – Бургас', judge: 'Георги Димов Пепеляшев', kn: '23 / 73', mult: '×3,06' },
  { court: 'РС–Пловдив · ЧНД (2025)', party: 'ОДМВР – Пловдив', judge: 'И. Бекяров + М. Георгиева', kn: '342/699 + 348/699', mult: '×4,88 / ×3,47' },
  { court: 'АССГ · Адм. (2025 / 2026)', party: 'ТД на НАП – София (Публичен изп.)', judge: 'Геновева Йончева / Владимир Николов', kn: '12/12 + 10/10 · 11/12 + 10/10', mult: '×27,40 / ×34,06' },
  { court: 'АССГ · Адм. (2026)', party: 'НЕЛК (121242837) / КЕВР (130098909)', judge: 'София Тодорова / Геновева Йончева', kn: '4/12 · 5/16', mult: '×9,53 / ×8,51' },
