              <th>Анекс-инфлация (Модул F7)</th>
              <th>Съдебен / ЗМИП статус (Модул J1 / J5 / J6)</th>
            </tr>
          </thead>
          <tbody>
            {cartelZmipRows.map((c) => (
              <tr data-sector={c.sector}>
