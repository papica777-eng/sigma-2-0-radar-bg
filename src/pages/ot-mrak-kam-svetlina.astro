                <td>{f.court}</td>
                <td><strong>{f.party}</strong></td>
                <td><strong>{f.judge}</strong></td>
                <td class="mono"><strong>{f.kn}</strong></td>
                <td class="mono">{f.exp}</td>
                <td class="mono" style="color:var(--crimson);font-weight:700;">{f.mult}</td>
                <td class="mono">{f.q}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLE 3: SECURITY SERVICES (CHND), NAP, NELK & KEVR -->
    <section class="svetlina-section" data-svet-section="security">
      <div class="svetlina-section-head">
        <h2>III. Силови структури (ЧНД по ЗСРС и чл. 251г ЗЕС), НАП, НЕЛК и КЕВР в ЕИСС</h2>
        <span class="mono" style="font-size:0.74rem;color:var(--ink-muted);">Вероятност за случайност до 1,10 &times; 10⁻¹⁶²</span>
      </div>
      <div class="table-wrap svetlina-compact-scroll">
        <table>
          <thead>
