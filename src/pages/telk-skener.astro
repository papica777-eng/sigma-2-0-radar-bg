---
import BaseLayout from '../layouts/BaseLayout.astro';
import telkRadarRaw from '../../docs/data/nasvetlo_telk_radar.json';

const nat = (telkRadarRaw as any).national || {};
const oblasts: any[] = Array.isArray((telkRadarRaw as any).oblasts) ? (telkRadarRaw as any).oblasts : [];
const asOf = String((telkRadarRaw as any).generatedAtUtc || '2026-11-24').slice(0, 10);

const fmtInt = (n: number) => Number(n || 0).toLocaleString('bg-BG');
const fmtEur = (n: number) =>
  Number(n || 0).toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
---

<BaseLayout
  title="NAsvetlo · ТЕЛК Скенер (Демо) — Суверенен Zero-Cloud & Zig AI верификатор"
  description="Публично интерактивно продуктово демо на суверенната платформа ТЕЛК Скенер (Zero-Cloud Rust/WASM + Zig 0.15.2 Int8 Tiny-AI + .soul Чатушкоти + НМЕ Приложение № 2 + 28-областен НОИ радар) — оферта за безвъзмездно дарение на държавата по ССЕВ."
  asOf={asOf}
  subpage={true}
  canonicalPath="/telk-skener.html"
  subpageScript="sigma3/telk_skener_demo.js?v=20261124a"
  subpageSyncHref="data/nasvetlo_telk_radar.json"
>
  <section class="telk-hero" id="top">
    <div class="telk-hero-kicker">
      <span class="inv-kicker">
        <span class="mini-win-dot" aria-hidden="true"></span>
        <span>ПУБЛИЧНА ПРОДУКТОВА ДЕМОНСТРАЦИЯ · ZERO-CLOUD · GDPR ЧЛ. 9 &amp; ЧЛ. 22</span>
      </span>
      <span class="mono" style="font-size:0.75rem;color:var(--ink-muted);">
        Официален НОИ масив: {asOf} · Двигател: ZIG_0_15_2_SIMD_WASM (0 хост импорти)
      </span>
    </div>
    <h1 class="telk-hero-title">ТЕЛК Скенер — Суверенна проверка на експертни решения и „фалшиви диагнози“</h1>
    <p class="telk-hero-sub">
      Независима българска система за предварителна и последваща верификация на ТЕЛК документи в локалната памет на браузъра
      (<strong>0 облачни заявки, 0 съхранени ЕГН</strong>). Обединява криптографска PAdES/XAdES проверка, точна формула по
      <strong>НМЕ Приложение № 2, т. III (ДВ, бр. 10/2023)</strong>, имунитет за остри травми/онкология и компактен
      <strong>Int8 Tiny-AI (Zig 0.15.2 + Mojo + .soul Чатушкоти)</strong> за изолиране на фиктивни диагнози при здрави пациенти.
    </p>
    <div class="telk-cta-row">
      <a href="/ezdrave-telk.html" class="btn topbar-btn-telk">★ Прототип в стила на еЗдраве (Портал + Мобилно + Публичен контрол) &rarr;</a>
      <a href="#telkSimulatorSection" class="btn topbar-btn">1. Симулатор на живо (6 сценария)</a>
      <a href="#telkSandboxSection" class="btn topbar-btn">2. Интерактивен пясъчник (НРН + НМЕ + AI)</a>
      <a href="#telkBenchmarkSection" class="btn topbar-btn">3. Бенчмарк 10 000 казуса (100% Recall / 0% FPR)</a>
      <a href="#telkRadarSection" class="btn topbar-btn">4. 28-областен НОИ радар</a>
      <a href="data/nasvetlo_telk_radar.json" download class="btn topbar-btn">Изтегли НОИ масив (.json) &darr;</a>
    </div>
  </section>

  <div class="telk-ssev-banner" role="note">
    <strong>Оферта за безвъзмездно дарение към МЗ, НЕЛК, НОИ, МЕУ и „Информационно обслужване“ АД (чрез ССЕВ):</strong>
    Настоящата страница е <strong>публично интерактивно продуктово демо</strong> и умишлено не излага затворения производствен код
    (<code>telk-verifier-sovereign</code> — Rust/WASM, Zig 0.15.2 ядро, Mojo калибратор, <code>.soul</code> протокол и 244 E2E теста).
    Правообладателят предоставя цялото частно хранилище чрез <strong>безвъзмездно GitHub Repository Transfer</strong> под EUPL-1.2 / MIT след
    успешен 30-минутен <strong>Сляп пилот върху 1 000 исторически дела</strong> в air-gapped среда. Всички AI/Z-Score флагове са аналитичен триаж
    с <strong>задължителен присъствен лекарски преглед в независим състав на НЕЛК от друга област (чл. 22 GDPR)</strong>.
  </div>

  <section class="telk-kpi-strip" aria-label="Ключови национални и верификационни показатели">
    <div class="telk-kpi-card is-teal">
      <div class="telk-kpi-val">10 000 / 10 000</div>
      <div class="telk-kpi-lbl">Верифициран бенчмарк (287 дела/сек.)</div>
      <div class="telk-kpi-sub">34,87 сек. на 1 нишка · 0 външни мрежови заявки</div>
    </div>
    <div class="telk-kpi-card is-teal">
      <div class="telk-kpi-val">0,00% FPR</div>
      <div class="telk-kpi-lbl">Лъжливи аларми върху 4 000 контролни дела</div>
      <div class="telk-kpi-sub">Вкл. 750 тежко болни в BG425/BG325 и 750 остри травми</div>
    </div>
    <div class="telk-kpi-card is-crimson">
      <div class="telk-kpi-val">{fmtInt(nat.invPensioners2025)} лица</div>
      <div class="telk-kpi-lbl">Инвалидни пенсионери в България (НОИ 2025)</div>
      <div class="telk-kpi-sub">Годишен разход: {fmtEur(nat.invSpendEur2025)}</div>
    </div>
    <div class="telk-kpi-card is-ochre">
      <div class="telk-kpi-val">{fmtEur(nat.excessFiscalAnomalyAreasEur)}</div>
      <div class="telk-kpi-lbl">Излишен разход в аномални области (Z &gt; +0,75)</div>
      <div class="telk-kpi-sub">{nat.criticalOblastsCount || 2} критични (BG425, BG325) · {nat.highOblastsCount || 3} високорискови</div>
    </div>
  </section>

  <section class="telk-arch-grid" aria-label="Четирислойна суверенна архитектура">
    <article class="telk-stage-card">
      <h3>Слой 1: .soul Конституция &amp; Чатушкоти</h3>
      <p>
        Декларативни правила без <code>float</code> отклонения (2000 bps = +20,00% по НМЕ Приложение № 2, т. III) и 5 състояния:
        <code>FIRST</code> (Автентичен), <code>SECOND</code> (Фалшив), <code>THIRD</code> (Аномалия/Триаж), <code>FOURTH</code> (Неопределеност), <code>SUNYATA</code> (Въздържане).
      </p>
    </article>
    <article class="telk-stage-card">
      <h3>Слой 2: Zig 0.15.2 Int8 Tiny-AI + SimHash</h3>
      <p>
        Квантизиран модел <code>16→24→12→3</code> (калибриран в Mojo), конформен 95% доверителен интервал (Директива (ЕС) 2024/2853),
        16 контрафактуални атрибуции и 64-битов SimHash за засичане на клонирани шаблонни епикризи.
      </p>
    </article>
    <article class="telk-stage-card">
      <h3>Слой 3: Rust/WASM Крипто &amp; Клиничен одит</h3>
      <p>
        Бинарен PAdES <code>/ByteRange</code>, XAdES-BES + X.509 DER (B-Trust, Евротръст, Инфонотари, StampIT), 12-цифрен НРН (Modulo 11),
        хроничен vs остър траекторен филтър и SHA-512 Merkle верига.
      </p>
    </article>
    <article class="telk-stage-card">
      <h3>Слой 4: Независим лекарски контрол (НЕЛК)</h3>
      <p>
        Zero-Cloud GDPR чл. 9 защита: ЕГН никога не се събира в публичното демо. Всеки риск от Клас Б+В спира автоматично
        плащането само до присъствен преглед от независим НЕЛК състав от друга област (чл. 22 GDPR).
      </p>
    </article>
  </section>

  <!-- 1. LIVE 6-SCENARIO SIMULATOR -->
  <section class="telk-panel" id="telkSimulatorSection">
    <div class="inv-section-header" style="margin-bottom:10px;">
      <h2>1. Симулатор на живо: Как системата различава истински от подправени и фиктивни ТЕЛК решения</h2>
      <span class="inv-section-meta">Изберете казус с 1 клик (клиентска симулация без сървър)</span>
    </div>

    <div class="telk-scenario-bar" id="telkScenarioBar" role="tablist" aria-label="Демо сценарии">
      <button type="button" class="telk-scn-btn active" data-scn="authentic_plovdiv">1. Автентично ЕР (Пловдив BG421)</button>
      <button type="button" class="telk-scn-btn" data-scn="acute_trauma">2. Остра травма с реална 07 епикриза</button>
      <button type="button" class="telk-scn-btn" data-scn="tampered_pdf">3. Подправен PDF (+17 байта)</button>
      <button type="button" class="telk-scn-btn" data-scn="preseal_mismatch">4. Подменен ТНР 50%→72% (Pre-Seal)</button>
      <button type="button" class="telk-scn-btn" data-scn="fabricated_healthy">5. Фалшива диагноза на здрав човек (НМЕ + НЗИС + AI)</button>
      <button type="button" class="telk-scn-btn" data-scn="gdpr_block">6. Блокиран GDPR чл. 9 теч (PII Guard)</button>
    </div>

    <div id="telkSimulatorOutput" aria-live="polite"></div>
  </section>

  <!-- 2. INTERACTIVE SANDBOX -->
  <section class="telk-panel" id="telkSandboxSection">
    <div class="inv-section-header" style="margin-bottom:10px;">
      <h2>2. Интерактивен пясъчник: Тествай НРН (Modulo 11), НМЕ Приложение № 2 и Tiny-AI на живо</h2>
      <span class="inv-section-meta">0 лични данни · Без поле за ЕГН</span>
    </div>

    <div class="telk-sandbox-grid">
      <div class="telk-field">
        <label for="sbNrn">12-цифрен НРН (НЗИС Modulo 11)</label>
        <input id="sbNrn" type="text" value="260914071040" maxlength="12" />
      </div>
      <div class="telk-field">
        <label for="sbTrajectory">Траектория на диагнозата (МКБ-10)</label>
        <select id="sbTrajectory">
          <option value="chronic">Хронична (напр. I50.0 / E11.9 / I25.1)</option>
          <option value="acute">Остра травма / инсулт / онкология (S45.9 / C34.9)</option>
        </select>
      </div>
      <div class="telk-field">
        <label for="sbP1">Водещо увреждане P1 (%)</label>
        <input id="sbP1" type="number" min="0" max="100" value="30" />
      </div>
      <div class="telk-field">
        <label for="sbP2">Второ увреждане P2 (%)</label>
        <input id="sbP2" type="number" min="0" max="100" value="20" />
      </div>
      <div class="telk-field">
        <label for="sbP3">Трето увреждане P3 (%)</label>
        <input id="sbP3" type="number" min="0" max="100" value="20" />
      </div>
      <div class="telk-field">
        <label for="sbDeclaredTnr">Отчетен краен ТНР в ЕР (%)</label>
        <input id="sbDeclaredTnr" type="number" min="0" max="100" value="70" />
      </div>
      <div class="telk-field">
        <label for="sbAgeDays">Давност на диагнозата (дни)</label>
        <input id="sbAgeDays" type="number" min="0" max="3650" value="7" />
      </div>
      <div class="telk-field">
        <label for="sbRxCount">Изпълнени е-рецепти (24 мес.)</label>
        <input id="sbRxCount" type="number" min="0" max="120" value="0" />
      </div>
      <div class="telk-field">
        <label for="sbObjCount">Обективни изследвания (ЕКГ/ЕМГ/ЯМР НРН)</label>
        <select id="sbObjCount">
          <option value="0">0 броя (само словесно описание)</option>
          <option value="1">1+ валидни НРН изследвания</option>
        </select>
      </div>
      <div class="telk-field">
        <label for="sbEpicrisis">Болнична епикриза (07) приложена?</label>
        <select id="sbEpicrisis">
          <option value="0">Не</option>
          <option value="1">Да (валиден 07 НРН)</option>
        </select>
      </div>
      <div class="telk-field">
        <label for="sbNarrative">Клиничен текст (противоречие с ТНР)</label>
        <select id="sbNarrative">
          <option value="contradiction">„Без оплаквания, нормална ЕхоКГ, ФИ 62%“</option>
          <option value="coherent">Кохерентна обективна клинична находка</option>
        </select>
      </div>
      <div class="telk-field">
        <label for="sbOblast">Област (NUTS-3)</label>
        <select id="sbOblast">
          <option value="BG421">BG421 — Пловдив (BASELINE)</option>
          <option value="BG425">BG425 — Кърджали (CRITICAL 83)</option>
          <option value="BG325">BG325 — Силистра (CRITICAL 72)</option>
          <option value="BG313">BG313 — Враца (HIGH 57)</option>
          <option value="BG411">BG411 — София (столица)</option>
        </select>
      </div>
    </div>

    <div id="telkSandboxResult" aria-live="polite"></div>
  </section>

  <!-- 3. 10,000-CASE BENCHMARK CONFUSION MATRIX -->
  <section class="telk-panel" id="telkBenchmarkSection">
    <div class="inv-section-header" style="margin-bottom:10px;">
      <h2>3. Верифицирана матрица на объркването върху 10 000 ТЕЛК казуса (287 дела/сек.)</h2>
      <span class="inv-section-meta">Двигател: telk_verifier_wasm.wasm (ZIG_0_15_2_SIMD_WASM)</span>
    </div>

    <div class="inv-table-wrap">
      <table class="inv-table">
        <thead>
          <tr>
            <th>Направление / Кохорта</th>
            <th class="num">Верен риск (TP)</th>
            <th class="num">Лъжливи аларми (FP)</th>
            <th class="num">Вярна норма (TN)</th>
            <th class="num">Пропуски (FN)</th>
            <th class="num">Recall</th>
            <th class="num">FPR</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Клас А: Криптографски и документни фалшификати (3 000 дела)</strong></td>
            <td class="num">3 000</td>
            <td class="num">0</td>
            <td class="num">7 000</td>
            <td class="num">0</td>
            <td class="num"><span class="inv-tag tag-ok">100,00%</span></td>
            <td class="num">0,00%</td>
          </tr>
          <tr>
            <td><strong>Клас Б+В: Системни схеми, фалшиви диагнози и НМЕ инфлация (3 000 дела)</strong></td>
            <td class="num">3 000</td>
            <td class="num">0</td>
            <td class="num">4 000</td>
            <td class="num">0</td>
            <td class="num"><span class="inv-tag tag-ok">100,00%</span></td>
            <td class="num">0,00%</td>
          </tr>
          <tr>
            <td><strong>Общо отсяване (6 000 рискови vs 4 000 автентични контролни)</strong></td>
            <td class="num">6 000</td>
            <td class="num">0</td>
            <td class="num">4 000</td>
            <td class="num">0</td>
            <td class="num"><span class="inv-tag tag-ok">100,00%</span></td>
            <td class="num"><strong>0,00%</strong></td>
          </tr>
          <tr>
            <td><strong>Защитна контрола 1: 750 тежко болни (95% ТНР) в Кърджали &amp; Силистра</strong></td>
            <td class="num">—</td>
            <td class="num">0</td>
            <td class="num">750</td>
            <td class="num">0</td>
            <td class="num">—</td>
            <td class="num"><span class="inv-tag tag-ok">0,00%</span></td>
          </tr>
          <tr>
            <td><strong>Защитна контрола 2: 750 остри травми/инсулти/онкология (&lt;30 дни, 0 хроник Rx)</strong></td>
            <td class="num">—</td>
            <td class="num">0</td>
            <td class="num">750</td>
            <td class="num">0</td>
            <td class="num">—</td>
            <td class="num"><span class="inv-tag tag-ok">0,00%</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 4. 28-OBLAST NOI FORENSIC TABLE & BLIND PILOT SUMMARY -->
  <section class="telk-panel" id="telkRadarSection">
    <div class="inv-section-header" style="margin-bottom:10px;">
      <h2>4. 28-областен НОИ радар ({fmtInt(oblasts.length)} NUTS-3 области) &amp; Сляп пилот (1 000 дела)</h2>
      <span class="inv-section-meta">Пълно разграничаване на BG411 София (столица) от BG412 София</span>
    </div>

    <div class="inv-filter-toolbar">
      <input id="telkRadarSearch" type="search" class="inv-input" placeholder="Търсене по област или NUTS-3 код (напр. BG425, Кърджали, BG411)..." />
      <select id="telkRadarTierFilter" class="inv-select" aria-label="Филтър по рисков профил">
        <option value="ALL">Всички 28 области</option>
        <option value="CRITICAL">CRITICAL (&ge; 70)</option>
        <option value="HIGH">HIGH (52–69)</option>
        <option value="ELEVATED">ELEVATED (38–51)</option>
        <option value="BASELINE">BASELINE (&lt; 38)</option>
      </select>
    </div>

    <div class="inv-table-wrap">
      <table class="inv-table">
        <thead>
          <tr>
            <th>Ранг</th>
            <th>NUTS-3 &amp; Област</th>
            <th>Ниво</th>
            <th class="num">Риск индекс</th>
            <th class="num">Пенсионери (2025)</th>
            <th class="num">На 1 000 жит.</th>
            <th class="num">2-год. ръст</th>
            <th class="num">Излишен разход (€)</th>
          </tr>
        </thead>
        <tbody id="telkRadarTbody">
          {oblasts
            .slice()
            .sort((a, b) => Number(a.riskRank || 99) - Number(b.riskRank || 99))
            .map((o) => {
              const cls = o.riskTier === 'CRITICAL' ? 'tag-crit' : o.riskTier === 'HIGH' ? 'tag-warn' : 'tag-ok';
              return (
                <tr>
                  <td class="mono">{o.riskRank}</td>
                  <td><strong>{o.name}</strong> <span class="mono" style="color:var(--ink-muted);">{o.nuts3}</span></td>
                  <td><span class={`inv-tag ${cls}`}>{o.riskTier}</span></td>
                  <td class="num"><strong>{o.telkRiskScore}/99</strong></td>
                  <td class="num">{fmtInt(o.invPensioners2025)}</td>
                  <td class="num">{String(o.per1000Pop2025).replace('.', ',')}</td>
                  <td class="num">{String(o.growth2yPct).replace('.', ',')}%</td>
                  <td class="num">{fmtEur(o.excessFiscalSpendEur)}</td>
                </tr>
              );
            })}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
