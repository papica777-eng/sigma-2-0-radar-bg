---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFunnel from '../components/HeroFunnel.astro';
import NavTabs from '../components/NavTabs.astro';
import Tab01Dashboard from '../components/tabs/Tab01Dashboard.astro';
import Tab02Atlas from '../components/tabs/Tab02Atlas.astro';
import Tab03Directory from '../components/tabs/Tab03Directory.astro';
import Tab04Deep from '../components/tabs/Tab04Deep.astro';
import Tab05Forensics7 from '../components/tabs/Tab05Forensics7.astro';
import Tab06Judicial6 from '../components/tabs/Tab06Judicial6.astro';
import Tab07Cartels from '../components/tabs/Tab07Cartels.astro';
import Tab08Authorities from '../components/tabs/Tab08Authorities.astro';
import Tab09Companies from '../components/tabs/Tab09Companies.astro';
import Tab10Graph9Node from '../components/tabs/Tab10Graph9Node.astro';
import Tab11Oracle from '../components/tabs/Tab11Oracle.astro';
import Tab12Proposal from '../components/tabs/Tab12Proposal.astro';
import Tab13FiscalXray from '../components/tabs/Tab13FiscalXray.astro';
import j6Raw from '../../docs/data/sigma3_judicial_6.json';
import invRaw from '../../docs/data/nasvetlo_investigations.json';
import telkRaw from '../../docs/data/nasvetlo_telk_radar.json';
import fiscalRaw from '../../docs/data/nasvetlo_fiscal_edp.json';

const dynamicAsOf = [
  String((j6Raw as any).generatedAtUtc || '').slice(0, 10),
  String((invRaw as any).generatedAtUtc || '').slice(0, 10),
  String((telkRaw as any).generatedAtUtc || '').slice(0, 10),
  String((fiscalRaw as any).generatedAtUtc || '').slice(0, 10),
  '2026-11-23',
].filter(Boolean).sort().pop() || '2026-11-23';
---
<BaseLayout asOf={dynamicAsOf}>
  <a class="svetlina-banner" href="ot-mrak-kam-svetlina.html" title="Отвори „От мрак към светлина“ — съдебен радар на 180 съдилища и 364 RED флага">
    <span class="svetlina-banner__tag">НОВО · ЕИСС × ЗОП × ЕППО</span>
    <div class="svetlina-banner__body">
      <div class="svetlina-banner__title">От мрак към светлина — Национален съдебен и прокурорски радар</div>
      <div class="svetlina-banner__sub">Пълен алгоритмичен одит на <strong>1 118 765 дела</strong> в <strong>180 съдилища</strong> (28 области · 2 714 съдии), адвокатски кантори, свързани политици и регистър на всички <strong>364 RED флага</strong></div>
    </div>
    <span class="svetlina-banner__cta btn btn-dark">Отвори одита &rarr;</span>
  </a>
  <HeroFunnel asOf={dynamicAsOf} />
  <NavTabs />
  <Tab01Dashboard />
  <Tab13FiscalXray />
  <Tab02Atlas />
  <Tab03Directory />
  <Tab04Deep />
  <Tab05Forensics7 />
  <Tab06Judicial6 />
  <Tab07Cartels />
  <Tab08Authorities />
  <Tab09Companies />
  <Tab10Graph9Node />
  <Tab11Oracle />
  <Tab12Proposal />
</BaseLayout>
