---
import BaseLayout from '../layouts/BaseLayout.astro';
import netDataRaw from '../../docs/data/nasvetlo_network_graph.json';

const net = netDataRaw as any;
const s = net.summary || {};
const nodes: any[] = net.nodes || [];
const edges: any[] = net.edges || [];
const clusters: any[] = net.clusters || [];
const featuredPaths: any[] = s.featuredPaths || [];

const fmtInt = (n: number) => Number(n || 0).toLocaleString('bg-BG');
const fmtEurShort = (n: number) => {
  const v = Number(n || 0);
  if (!Number.isFinite(v) || v <= 0) return '—';
  if (v >= 1e9) return `€${(v / 1e9).toFixed(2).replace('.', ',')} млрд.`;
  if (v >= 1e6) return `€${(v / 1e6).toFixed(1).replace('.', ',')} млн.`;
  if (v >= 1e3) return `€${Math.round(v / 1e3).toLocaleString('bg-BG')} хил.`;
  return `€${Math.round(v).toLocaleString('bg-BG')}`;
};

const asOf = String(net.generatedAtUtc || '2026-11-27').slice(0, 10);

const CLUSTER_INFO: Record<string, { kicker: string; title: string; desc: string; accent: string }> = {
  ROAD_SECTOR: {
    kicker: 'Клъстер 01 · Инфраструктура & АПИ',
    title: 'Строително-инфраструктурен сектор & АПИ',
    desc: 'Компании с договори за стотици милиони евро по ЗОП (Пътинженерингстрой-Т, Запрянови-03, Еко-Хидро-90, Пътища и мостове, Градив), свързани с реални търговски производства по ЕИСС срещу АПИ и общини.',
    accent: '#f97316',
  },
  MUNICIPAL_AFFILIATION: {
    kicker: 'Клъстер 02 · Местна власт · чл. 49 ЗПК',
    title: 'Общинска свързаност & Декларации по ЗПК',
    desc: 'Кметове, общински съветници и публични лица (Благоевград, Хасково, Неделино, Белово, Пловдив, Столична община, Шумен, Самоков), чиито свързани дружества по ТР са изпълнители по ЗОП.',
    accent: '#d97706',
  },
  JUDICIAL_CONCENTRATION: {
    kicker: 'Клъстер 03 · Съдебна мрежа & Модул J3',
    title: 'ЕИСС концентрации (q < 0,01) & Правни договори',
    desc: 'Статистически необяснени концентрации в случайното разпределение (Benjamini–Hochberg FDR q < 0,01), връзки адвокат → съдия (Ниво 3) и договори за правни услуги по CPV 791 без състезание.',
    accent: '#7c3aed',
  },
  ENERGY_SECTOR: {
    kicker: 'Клъстер 04 · Енергетика & ВиК',
    title: 'Енергиен & ВиК сектор',
    desc: 'Взаимни искове, ЗОП поръчки и правни договори между държавни енергийни оператори (ЕСО ЕАД, Булгартрансгаз ЕАД, АЕЦ Козлодуй ЕАД), ВиК дружества и частни ТЕЦ-ове / доставчици за десетки милиони евро.',
    accent: '#0891b2',
  },
  HEALTH_SECTOR: {
    kicker: 'Клъстер 05 · Здравеопазване & ТЕЛК',
    title: 'Болнични центрове, НЗОК & ТЕЛК епицентър',
    desc: 'Областни болници (Кърджали, Силистра), застрахователни дружества и доставчици на медицинска апаратура, свързани с търговски спорове в СГС и фискални обеми по НЗОК/НОИ.',
    accent: '#db2777',
  },
};

const graphPayloadJson = JSON.stringify({
  generatedAtUtc: net.generatedAtUtc,
  methodologyVersion: net.methodologyVersion,
  summary: s,
  clusters,
  nodes,
  edges,
});
---

<BaseLayout
  title="NAsvetlo — МРЕЖАТА: Пълна верига на капитала и институционалната свързаност"
  description={`Интерактивен форензик граф на пълната капиталова и институционална верига в България: ${fmtInt(s.totalNodes)} възела, ${fmtInt(s.totalUbos)} крайни собственици (ЗМИП), ${fmtInt(s.totalEdges)} верифицирани връзки и ${fmtInt(s.bridgeNodesCount)} мулти-клъстерни моста върху ${fmtEurShort(s.totalInvestigatedResourceEur)} публичен ресурс.`}
  asOf={asOf}
  subpage={true}
  canonicalPath="/mrezhata.html"
  subpageScript="sigma3/mrezhata_engine.js?v=20261128d"
  subpageSyncHref="data/nasvetlo_network_graph.json"
  ogImage="https://nasvetlo.website/sigma3/og-mrezhata.jpg"
>
  <!-- Hero Section -->
  <section class="mrezha-hero has-bg-emblem is-mrezhata" id="top">
    <div class="mrezha-kicker">
      <span class="kicker-dot" aria-hidden="true"></span>
      <span>ПЪЛНА КАПИТАЛОВА ВЕРИГА &middot; ЗМИП ЧЛ. 63 &middot; BRANDES CENTRALITY &middot; SHA-256</span>
    </div>
    <h1 class="mrezha-title">МРЕЖАТА: Пълна верига на капитала и институционалната свързаност</h1>
    <p class="mrezha-subtitle">
      Интерактивна аналитична система, проследяваща пълната документална верига по единен ЕИК:
      <strong>Възложител &rarr; ДЗЗД консорциум &rarr; Изпълнител &rarr; Холдинг-майка &rarr; Действителен собственик (чл. 63 ЗМИП)</strong>,
      кръстосана с търговски дела (ЕПЕП/ЕИСС), адвокатски кантори (Модул J3) и декларации пред КПК по ЗПК.
      Всяка връзка носи първичен официален идентификатор и подлежи на локална криптографска проверка.
    </p>

    <!-- 6-Tile Institutional KPI Grid -->
    <div class="mrezha-kpi-grid">
      <div class="mrezha-kpi-card is-crimson">
        <div class="mrezha-kpi-val">{fmtEurShort(s.totalInvestigatedResourceEur)}</div>
        <div class="mrezha-kpi-lbl">Анализиран финансов ресурс</div>
      </div>
      <div class="mrezha-kpi-card is-teal">
        <div class="mrezha-kpi-val">{fmtInt(s.totalUbos || 0)}</div>
        <div class="mrezha-kpi-lbl">Крайни собственици (ЗМИП)</div>
      </div>
      <div class="mrezha-kpi-card is-purple">
        <div class="mrezha-kpi-val">{fmtInt(s.totalNodes)}</div>
        <div class="mrezha-kpi-lbl">Картографирани възела</div>
      </div>
      <div class="mrezha-kpi-card is-blue">
        <div class="mrezha-kpi-val">{fmtInt(s.totalEdges)}</div>
        <div class="mrezha-kpi-lbl">Верифицирани връзки</div>
      </div>
      <div class="mrezha-kpi-card is-amber">
        <div class="mrezha-kpi-val">{fmtInt(s.bridgeNodesCount)}</div>
        <div class="mrezha-kpi-lbl">Мулти-клъстерни мостове</div>
      </div>
      <div class="mrezha-kpi-card is-ink">
        <div class="mrezha-kpi-val is-compact">{fmtInt(s.largestComponentSize)} / {fmtInt(s.connectedComponentsCount)}</div>
        <div class="mrezha-kpi-lbl">Макс. компонента / Общо групи</div>
      </div>
    </div>
  </section>

  <!-- Enterprise Forensic Graph Workspace -->
  <section class="mrezha-graph-section" id="mrezhaWorkspace">
    <!-- Command Bar Tier 1: Search, Layout Switcher, Shortest Path, Sizing, Export -->
    <div class="mrezha-command-bar">
      <div class="mrezha-cmd-row">
        <!-- Autocomplete Search -->
        <div class="mrezha-search-wrap">
          <div class="mrezha-search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="mrezhaSearchInput"
              placeholder="Търси фирма, ЕИК, съдия, дело, община... (натисни /)"
              autocomplete="off"
            />
          </div>
          <div class="mrezha-ac-dropdown" id="mrezhaSearchDropdown" hidden></div>
        </div>

        <!-- 4-Mode Topological Layout Switcher -->
        <div class="mrezha-layout-group" role="group" aria-label="Топологично оформление">
          <button type="button" class="mrezha-layout-btn is-active" data-layout="force" title="Клъстерна физика (Force-Directed)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="5" r="2.5"></circle>
              <circle cx="5" cy="18" r="2.5"></circle>
              <circle cx="19" cy="18" r="2.5"></circle>
              <line x1="10.7" y1="7.2" x2="6.3" y2="15.8"></line>
              <line x1="13.3" y1="7.2" x2="17.7" y2="15.8"></line>
              <line x1="7.5" y1="18" x2="16.5" y2="18"></line>
            </svg>
            <span>Физика</span>
          </button>
          <button type="button" class="mrezha-layout-btn" data-layout="radial" title="Концентрична йерархия по централност">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <circle cx="12" cy="12" r="5"></circle>
              <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
            <span>Радиален</span>
          </button>
          <button type="button" class="mrezha-layout-btn" data-layout="stratified" title="7-слойна пълна капиталова и съдебна верига (ЗМИП → ЗПК → Възложител → Фирма → Кантора → Съдия → Дело)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="4" y1="4" x2="4" y2="20"></line>
              <line x1="12" y1="4" x2="12" y2="20"></line>
              <line x1="20" y1="4" x2="20" y2="20"></line>
              <circle cx="4" cy="8" r="2" fill="currentColor"></circle>
              <circle cx="12" cy="13" r="2" fill="currentColor"></circle>
              <circle cx="20" cy="9" r="2" fill="currentColor"></circle>
            </svg>
            <span>7-слоен</span>
          </button>
          <button type="button" class="mrezha-layout-btn" data-layout="matrix" title="Секторна матрица по 5 клъстера">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="7.5" height="7.5"></rect>
              <rect x="13.5" y="3" width="7.5" height="7.5"></rect>
              <rect x="3" y="13.5" width="7.5" height="7.5"></rect>
              <rect x="13.5" y="13.5" width="7.5" height="7.5"></rect>
            </svg>
            <span>Клъстери</span>
          </button>
        </div>

        <!-- Shortest-Path Finder Trigger -->
        <button type="button" class="mrezha-tool-btn is-accent" id="togglePathFinderBtn" title="Открий най-кратката документална верига между два субекта">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="5" cy="18" r="3"></circle>
            <circle cx="19" cy="6" r="3"></circle>
            <path d="M8 18h4a2 2 0 0 0 2-2V8a2 2 0 0 1 2-2h0"></path>
          </svg>
          <span>Път A &harr; B</span>
        </button>

        <!-- Action Utility Icons -->
        <div class="mrezha-action-group">
          <button type="button" class="mrezha-icon-btn" id="toggleCanvasThemeBtn" title="Превключи платното (Тъмно телеметрично / Светло печатно)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
            </svg>
          </button>
          <button type="button" class="mrezha-icon-btn" id="exportPngBtn" title="Експорт на графа във висока резолюция (2x PNG с SHA-256 печат)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>PNG</span>
          </button>
          <button type="button" class="mrezha-icon-btn" id="exportJsonBtn" title="Експорт на видимия подграф в JSON">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span>JSON</span>
          </button>
          <button type="button" class="mrezha-icon-btn" id="toggleFullscreenBtn" title="Режим Цял екран (Esc за изход)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Expandable Shortest-Path Finder Drawer -->
      <div class="mrezha-path-panel" id="mrezhaPathPanel" hidden>
        <div class="path-inputs-row">
          <div class="path-field">
            <label for="pathFromInput">Начален субект (А)</label>
            <input type="text" id="pathFromInput" placeholder="Въведете лице, фирма, ЕИК или съдия..." autocomplete="off" />
            <div class="mrezha-ac-dropdown" id="pathFromDropdown" hidden></div>
          </div>
          <span class="path-arrow-sep" aria-hidden="true">&harr;</span>
          <div class="path-field">
            <label for="pathToInput">Целеви субект (Б)</label>
            <input type="text" id="pathToInput" placeholder="Въведете лице, фирма, дело или съдия..." autocomplete="off" />
            <div class="mrezha-ac-dropdown" id="pathToDropdown" hidden></div>
          </div>
          <button type="button" class="mrezha-path-run-btn" id="btnRunPathFinder">Открий верига</button>
        </div>
        {featuredPaths.length > 0 && (
          <div class="path-presets-row">
            <span class="path-presets-lbl">Верифицирани вериги (1 клик):</span>
            {featuredPaths.map((fp) => (
              <button
                type="button"
                class="mrezha-preset-path-btn"
                data-from={fp.fromId}
                data-to={fp.toId}
              >
                {fp.title} ({fp.hops} прехода)
              </button>
            ))}
          </div>
        )}
        <div class="mrezha-path-result" id="mrezhaPathResult" hidden></div>
      </div>

      <!-- Command Bar Tier 2: Geometric Entity Type Chips + Analytical Filters -->
      <div class="mrezha-cmd-row is-filters">
        <div class="mrezha-filters" role="group" aria-label="Филтър по тип обект">
          <button type="button" class="mrezha-filter-btn is-active" data-filter="all">
            <span>Всички ({nodes.length})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="ubo">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><polygon points="8,1.2 14.5,6 12,14 4,14 1.5,6" fill="#059669" fill-opacity="0.28" stroke="#059669" stroke-width="1.7"/><circle cx="8" cy="8.2" r="2" fill="#059669"/></svg>
            <span>ЗМИП собственици ({s.totalUbos || 0})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="company">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><polygon points="8,1.5 14,5 14,11 8,14.5 2,11 2,5" fill="#e11d48" fill-opacity="0.25" stroke="#e11d48" stroke-width="1.7"/></svg>
            <span>Фирми &amp; ДЗЗД ({s.totalCompanies || 0})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="authority">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5L13.5 3.8V8.2C13.5 11.4 11.1 13.7 8 14.8C4.9 13.7 2.5 11.4 2.5 8.2V3.8L8 1.5Z" fill="#2563eb" fill-opacity="0.25" stroke="#2563eb" stroke-width="1.7"/></svg>
            <span>Възложители ({s.totalAuthorities || 0})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="judge">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><polygon points="5.2,1.5 10.8,1.5 14.5,5.2 14.5,10.8 10.8,14.5 5.2,14.5 1.5,10.8 1.5,5.2" fill="#7c3aed" fill-opacity="0.25" stroke="#7c3aed" stroke-width="1.7"/></svg>
            <span>Съдии ({s.totalJudges || 0})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="lawyer">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><rect x="2.2" y="2.2" width="11.6" height="11.6" rx="2.2" fill="#0891b2" fill-opacity="0.25" stroke="#0891b2" stroke-width="1.7"/></svg>
            <span>Кантори ({s.totalLawyers || 0})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="official">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="#d97706" fill-opacity="0.25" stroke="#d97706" stroke-width="1.7"/><circle cx="8" cy="8" r="2.2" fill="#d97706"/></svg>
            <span>ЗПК лица ({s.totalOfficials || 0})</span>
          </button>
          <button type="button" class="mrezha-filter-btn" data-filter="case">
            <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><polygon points="8,1.2 14.8,8 8,14.8 1.2,8" fill="#db2777" fill-opacity="0.25" stroke="#db2777" stroke-width="1.7"/></svg>
            <span>Дела ({s.totalCases || 0})</span>
          </button>
        </div>

        <div class="mrezha-selects">
          <select id="mrezhaClusterFilter" class="mrezha-select" aria-label="Филтър по секторен клъстер">
            <option value="ALL">Всички клъстери</option>
            <option value="ROAD_SECTOR">Инфраструктура &amp; АПИ</option>
            <option value="MUNICIPAL_AFFILIATION">Местна власт (чл. 49 ЗПК)</option>
            <option value="JUDICIAL_CONCENTRATION">Съдебна концентрация &amp; J3</option>
            <option value="ENERGY_SECTOR">Енергетика &amp; ВиК</option>
            <option value="HEALTH_SECTOR">Здравеопазване &amp; ТЕЛК</option>
          </select>

          <select id="mrezhaEdgeFilter" class="mrezha-select" aria-label="Филтър по тип връзка">
            <option value="ALL">Всички връзки</option>
            <option value="beneficial_owner">Действителен собственик (ЗМИП)</option>
            <option value="holding_control">Холдингов контрол / Феникс</option>
            <option value="consortium_member">Мега-консорциум (ДЗЗД)</option>
            <option value="political_donor">Партиен дарител (ЕРИК × ЗОП)</option>
            <option value="cartel_rotation">Картелна ротация / Нарязване</option>
            <option value="state_concession">Концесии МЕ / Държавен резерв</option>
            <option value="license_violation">Изтекъл / Отнет лиценз (ДНСК / МВР)</option>
            <option value="ivss_sanction">ИВСС санкции / Неподали (ЗСВ)</option>
            <option value="won_zop">ЗОП договори</option>
            <option value="conflict_of_interest">Свързаност чл. 49 ЗПК</option>
            <option value="owns_share">Собственост / Акции (КПК)</option>
            <option value="awarded_legal_tender">Правни услуги (J3)</option>
            <option value="presided_case">Съдия / ЕИСС концентрация</option>
            <option value="disputes_with">Търговски / Съдебен спор</option>
            <option value="represented_by">Процесуална защита</option>
          </select>

          <select id="mrezhaSizeMetric" class="mrezha-select" aria-label="Мащабиране на възлите по показател">
            <option value="centrality">Размер: Централност</option>
            <option value="amount">Размер: Финансов обем</option>
            <option value="risk">Размер: Риск индекс</option>
            <option value="degree">Размер: Брой връзки</option>
          </select>

          <label class="mrezha-risk-control" for="mrezhaRiskSlider">
            <span>Мин. риск:</span>
            <input type="range" id="mrezhaRiskSlider" min="0" max="90" step="5" value="0" />
            <strong id="mrezhaRiskVal">Всички</strong>
          </label>

          <button type="button" class="mrezha-reset-btn" id="btnResetFilters" title="Нулирай всички филтри">Нулирай</button>
        </div>
      </div>
    </div>

    <!-- High-DPI Tactical Canvas Stage -->
    <div class="mrezha-canvas-container" id="canvasContainer">
      <canvas id="mrezhaCanvas"></canvas>

      <!-- Floating Glass Hover Tooltip -->
      <div class="mrezha-hover-tooltip" id="mrezhaHoverTooltip" hidden></div>

      <!-- Precision Geometric Legend (Nodes + Edges) -->
      <div class="mrezha-canvas-legend">
        <div class="legend-section-title">ВЪЗЛИ (ГЕОМЕТРИЯ)</div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><polygon points="8,1.2 14.5,6 12,14 4,14 1.5,6" fill="#059669"/></svg>
          <span>Краен собственик (ЗМИП)</span>
        </div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><polygon points="8,1.5 14,5 14,11 8,14.5 2,11 2,5" fill="#e11d48"/></svg>
          <span>Фирма / ДЗЗД / Холдинг</span>
        </div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><path d="M8 1.5L13.5 3.8V8.2C13.5 11.4 11.1 13.7 8 14.8C4.9 13.7 2.5 11.4 2.5 8.2V3.8L8 1.5Z" fill="#2563eb"/></svg>
          <span>Възложител / Орган</span>
        </div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><polygon points="5.2,1.5 10.8,1.5 14.5,5.2 14.5,10.8 10.8,14.5 5.2,14.5 1.5,10.8 1.5,5.2" fill="#7c3aed"/></svg>
          <span>Съдия / Магистрат</span>
        </div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="12" rx="2" fill="#0891b2"/></svg>
          <span>Адвокат / Кантора</span>
        </div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="#d97706" stroke-width="2.4"/><circle cx="8" cy="8" r="2.2" fill="#d97706"/></svg>
          <span>Публично лице (ЗПК)</span>
        </div>
        <div class="legend-item">
          <svg width="11" height="11" viewBox="0 0 16 16"><polygon points="8,1 15,8 8,15 1,8" fill="#db2777"/></svg>
          <span>Съдебно дело (ЕИСС)</span>
        </div>
        <div class="legend-divider"></div>
        <div class="legend-section-title">РЕБРА &amp; МАРКЕРИ</div>
        <div class="legend-item"><span class="legend-line" style="background:#10b981;"></span><span>ЗМИП собственик / ЗОП</span></div>
        <div class="legend-item"><span class="legend-line is-dashed" style="border-color:#f97316;"></span><span>Холдинг-майка / ДЗЗД</span></div>
        <div class="legend-item"><span class="legend-line is-dashed" style="border-color:#ef4444;"></span><span>Чл. 49 ЗПК / Мост</span></div>
        <div class="legend-item"><span class="legend-line" style="background:#8b5cf6;"></span><span>ЕИСС разпределение</span></div>
        <div class="legend-item"><span class="legend-ring-bridge"></span><span>Мулти-клъстерен мост</span></div>
      </div>

      <!-- Interactive Radar Minimap -->
      <div class="mrezha-minimap-wrap" title="Интерактивна радарна карта — кликнете или плъзнете за навигация">
        <div class="minimap-hdr">РАДАР · ОБЗОР</div>
        <canvas id="mrezhaMinimap" width="186" height="122"></canvas>
      </div>

      <!-- Telemetry Status Pill -->
      <div class="mrezha-telemetry-bar" id="mrezhaTelemetryStatus"></div>

      <!-- Camera & Physics Controls Dock -->
      <div class="mrezha-canvas-controls">
        <button type="button" id="zoomInBtn" title="Приближи (+)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
        <button type="button" id="zoomOutBtn" title="Отдалечи (-)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
        <button type="button" id="resetZoomBtn" title="Помести целия граф (0)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        </button>
        <button type="button" id="togglePhysicsBtn" title="Паузирай / Продължи физиката (Space)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
        </button>
        <button type="button" id="reheatPhysicsBtn" title="Отключи закачените възли и преподреди">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        </button>
      </div>

      <!-- 4-Layer Slide-Over Forensic Inspector Drawer -->
      <aside class="mrezha-inspector" id="mrezhaInspector" aria-hidden="true">
        <div class="mrezha-inspector-top">
          <span class="mrezha-inspector-badge" id="inspectorBadge">СУБЕКТ</span>
          <button type="button" class="mrezha-inspector-close" id="closeInspectorBtn" aria-label="Затвори">&times;</button>
        </div>
        <h3 class="mrezha-inspector-title" id="inspectorTitle">Изберете обект</h3>
        <div class="mrezha-inspector-meta" id="inspectorMeta"></div>

        <div class="mrezha-inspector-connections">
          <h4>Първични регистрови връзки (клик за преход)</h4>
          <div id="inspectorConnectionsList"></div>
        </div>

        <button type="button" class="mrezha-signal-btn" id="openSignalFromInspectorBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          <span>Генерирай институционален сигнал (EPPO / КПК / ИВСС)</span>
        </button>

        <button type="button" class="mrezha-signal-btn" id="printDossierFromInspectorBtn" style="margin-top:8px;background:var(--surface-alt);color:var(--ink);border:1px solid var(--border-strong);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Отпечатай A4 PDF Досие (SHA-256)</span>
        </button>
      </aside>
    </div>
  </section>

  <!-- Dynamic Thematic Clusters Section (Zero Hardcoded Numbers) -->
  <section class="mrezha-clusters-section">
    <div class="mrezha-section-hdr">
      <h2>Петте ключови сектора на крос-регистровата мрежа</h2>
      <p>Кликнете върху който и да е сектор, за да изолирате и фокусирате графа директно върху неговите възли и мостове.</p>
    </div>

    <div class="mrezha-cluster-grid">
      {clusters.map((cl) => {
        const info = CLUSTER_INFO[cl.id] || { kicker: cl.id, title: cl.title, desc: '', accent: '#ac1b18' };
        return (
          <button type="button" class="mrezha-cluster-card" data-cluster-focus={cl.id} style={`--cl-accent:${info.accent};`}>
            <div class="cluster-kicker">{info.kicker}</div>
            <h3 class="cluster-title">{info.title}</h3>
            <p class="cluster-desc">{info.desc}</p>
            <div class="cluster-meta-row">
              <span>Възли: <strong>{fmtInt(cl.nodesCount)}</strong></span>
              <span>Обем: <strong>{fmtEurShort(cl.amountEur)}</strong></span>
              <span class="cluster-risk">Макс. риск: {cl.maxRisk || 0}/100</span>
            </div>
          </button>
        );
      })}
    </div>
  </section>

  <!-- Synced Sortable Master Registry Table -->
  <section class="mrezha-clusters-section">
    <div class="mrezha-table-hdr-bar">
      <div class="mrezha-section-hdr" style="margin-bottom:0;">
        <h2>Регистър на картографираните обекти <span class="mrezha-count-pill" id="mrezhaTableCount">{nodes.length} / {nodes.length}</span></h2>
        <p>Пълен опис с Brandes централност, степен на свързаност и финансов обем. Кликнете на ред за фокус в графа.</p>
      </div>
      <div class="mrezha-table-controls">
        <input type="text" id="mrezhaTableSearch" class="mrezha-table-input" placeholder="Филтрирай таблицата по име, ЕИК, съд..." />
        <select id="mrezhaTableType" class="mrezha-select" aria-label="Категория в таблицата">
          <option value="ALL">Всички категории</option>
          <option value="ubo">Крайни собственици (ЗМИП)</option>
          <option value="company">Фирми / ДЗЗД / Холдинги</option>
          <option value="authority">Възложители / Ведомства</option>
          <option value="judge">Съдии / Магистрати</option>
          <option value="lawyer">Адвокатски кантори</option>
          <option value="official">Публични лица (ЗПК)</option>
          <option value="case">Съдебни дела (ЕИСС)</option>
        </select>
        <select id="mrezhaTableSort" class="mrezha-select" aria-label="Подредба на таблицата">
          <option value="centrality">Подреди: Централност</option>
          <option value="risk">Подреди: Риск индекс</option>
          <option value="amount">Подреди: Финансов обем</option>
          <option value="degree">Подреди: Брой връзки</option>
          <option value="name">Подреди: Азбучен ред</option>
        </select>
      </div>
    </div>

    <div class="mrezha-table-container">
      <table id="mrezhaTable">
        <thead>
          <tr>
            <th>Обект / Субект</th>
            <th>Категория</th>
            <th>Сектор</th>
            <th>Идентификатор / Съд</th>
            <th>Централност</th>
            <th>Връзки</th>
            <th>Финансов обем</th>
            <th>Риск индекс</th>
            <th>Действие</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <!-- Methodology, Legal Disclaimer & Client-Side Rust/Wasm Verifier -->
  <section class="mrezha-methodology-section" id="methodology">
    <div class="mrezha-section-hdr">
      <h2>Правна рамка, презумпция за невиновност и криптографска методология</h2>
      <p>Неутрална доказателствена архитектура върху публични държавни регистри с локална WebAssembly проверка.</p>
    </div>

    <div class="mrezha-disclaimer-grid">
      <div class="mrezha-disclaimer-card">
        <h3>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v18M4 7h16M5 7l-2 7h4l-2-7zm14 0l-2 7h4l-2-7z"/></svg>
          <span>Презумпция за невиновност и конституционни гаранции</span>
        </h3>
        <p>
          Всяко физическо и юридическо лице, посочено на тази платформа, се ползва от
          <strong>презумпцията за невиновност съгласно чл. 31, ал. 3 от Конституцията на Република България</strong> и
          <strong>чл. 6, ал. 2 от Европейската конвенция за защита на правата на човека (ЕКПЧ)</strong>.
          Визуализираните връзки представляват документална институционална и корпоративна свързаност по публични регистри и
          <strong>НЕ представляват влязла в сила присъда, обвинение или констатация за престъпление</strong>.
        </p>
      </div>

      <div class="mrezha-disclaimer-card">
        <h3>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          <span>Графова математика (Brandes, PageRank &amp; FDR q &lt; 0,01)</span>
        </h3>
        <p>
          Всички възли са унифицирани по първичен <strong>ЕИК</strong> и носят директни идентификатори от
          <strong>ЦАИС ЕОП (УНП)</strong>, <strong>ТРРЮЛНЦ</strong>, <strong>ЕПЕП/ЕИСС</strong> и <strong>КПК (чл. 49 ЗПК)</strong>.
          Индексът на централност комбинира точния алгоритъм на <em>Brandes</em> за посредничество (Betweenness Centrality),
          итеративен <em>PageRank</em> и статистическите флагове по <em>Benjamini–Hochberg FDR q &lt; 0,01</em>.
        </p>
      </div>

      <div class="mrezha-disclaimer-card">
        <h3>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
          <span>Криптографски печат (FIPS 180-4 SHA-256)</span>
        </h3>
        <p>
          Графът работи изцяло клиентски без сървърни бази данни (имунизиран срещу DDoS).
          Интегритетът на масива е гарантиран чрез каноничен SHA-256 хеш:
        </p>
        <div class="mrezha-sha-badge">
          <code>SHA-256: {s.datasetSha256}</code>
        </div>
        <button type="button" class="mrezha-wasm-btn" id="mrezhaWasmVerifyBtn">
          Криптографска проверка (SHA-256 &amp; GDPR)
        </button>
        <div id="mrezhaWasmVerifyOut" hidden></div>
      </div>

      <div class="mrezha-disclaimer-card">
        <h3>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line></svg>
          <span>ЗЗЛД / GDPR хигиена и право на отговор</span>
        </h3>
        <p>
          На ниво компилация и автоматични тестове е заложена строга защита: <strong>0 цивилни ЕГН</strong>,
          <strong>0 домашни адреса на физически лица</strong> и <strong>0 празни скоби</strong>.
          При актуализация в официалните държавни регистри (ТР, ЕИСС, КПК) всяко лице може да подаде корекция за синхронизация в седмичния бюлетин.
        </p>
      </div>
    </div>
  </section>

  <!-- 1-Click Institutional Signal Generator Modal (Zero Emojis) -->
  <div class="mrezha-signal-backdrop" id="signalBackdrop" hidden></div>
  <div class="mrezha-signal-modal" id="signalModal" hidden role="dialog" aria-modal="true" aria-labelledby="signalModalTitle">
    <div class="mrezha-signal-header">
      <h3 id="signalModalTitle">Институционален сигнал до EPPO, КПК, ИВСС и АДФИ</h3>
      <button type="button" id="closeSignalModalBtn" aria-label="Затвори">&times;</button>
    </div>
    <p class="mrezha-signal-sub">
      Автоматично генериран доказателствен проект с точни позовавания на ЕИК, ЦАИС ЕОП УНП, ЕИСС дела, Brandes централност и SHA-256 печат.
    </p>
    <pre class="mrezha-signal-pre" id="signalTextPre"></pre>
    <div class="mrezha-signal-actions">
      <button type="button" class="btn-cancel" id="cancelSignalBtn">Затвори</button>
      <button type="button" class="btn-copy" id="copySignalBtn">Копирай сигнала в клипборда</button>
    </div>
  </div>

  <!-- Embedded Zero-Latency Canonical Graph Payload -->
  <script id="mrezhataGraphPayload" type="application/json" set:html={graphPayloadJson}></script>
</BaseLayout>
