---
import BaseLayout from '../layouts/BaseLayout.astro';
import adm50 from '../../docs/data/nasvetlo_50_admins.json';
import inv from '../../docs/data/nasvetlo_investigations.json';

const sum50 = (adm50 as any).summary || {};
const sumInv = (inv as any).summary || {};
const asOf = String((inv as any).generatedAtUtc || '2026-11-22').slice(0, 10);

const fmtEurShort = (v: number) => {
  const n = Number(v || 0);
  if (n >= 1e9) return (n / 1e9).toFixed(2).replace('.', ',') + ' млрд. €';
  if (n >= 1e6) return (n / 1e6).toFixed(2).replace('.', ',') + ' млн. €';
  return Math.round(n).toLocaleString('bg-BG') + ' €';
};
const fmtInt = (v: number) => Number(v || 0).toLocaleString('bg-BG');

const bbCount = Number(sum50.statusBreakdown?.CLOSED_BLOCKED ?? 9);
const owCount = Number(sum50.statusBreakdown?.OPENWASHING_COSMETIC ?? 6);
const readyCount = Number(sum50.statusBreakdown?.OPEN_READY_FOR_LINK ?? 17);
const frozenCount = Number(sum50.statusBreakdown?.PARTIAL_FRAGMENTED ?? 10);
const connCount = Number(sum50.statusBreakdown?.CONNECTED_IN_NASVETLO ?? 8);
---

<BaseLayout
  title="NAsvetlo — Нови разследвания и Одит на 50-те държавни институции"
  description="Независим граждански одит на 50 ключови държавни администрации (€23,74 млрд. по ЗОП) в data.egov.bg и живи кръстосани разследвания между МВР (ЗЧОД), МЕ (кариери), ДНСК, ИААА, Държавен резерв, ПВУ и ЗОП."
  asOf={asOf}
  subpage={true}
  canonicalPath="/razsledvaniq.html"
>
  <section class="inv-hero" id="top">
    <div class="inv-kicker-row">
      <span class="inv-kicker">
        <span class="mini-win-dot" aria-hidden="true"></span>
        <span>НОВО · ОДИТ 50 &amp; ЖИВИ КРЪСТОСАНИ РАЗСЛЕДВАНИЯ</span>
      </span>
      <span class="mono" style="font-size:0.74rem;color:var(--ink-muted);">Актуализирано: {asOf} · CC-BY 4.0 / CC0 (data.egov.bg × ЗОП)</span>
    </div>
    <h1 class="inv-hero-title">Нови разследвания и карта на прозрачността на 50-те институции</h1>
    <p class="inv-hero-sub">
      Детерминистично сечение по 9-цифрен ЕИК и точно правно наименование между <strong>{fmtInt(sumInv.totalCrossLinkedRegistries || 11)} отворени държавни регистъра</strong> от <code>data.egov.bg</code> и масива на NAsvetlo (17 428 изпълнители по ЗОП, 571 политически свързани лица и 206 907 договора), съчетано с пълен одит на достъпността и корупционния риск на 50-те ключови администрации ({fmtEurShort(sum50.totalAuditZopEur)} по ЗОП).
    </p>
    <div class="inv-nav-actions">
      <a href="./" class="btn topbar-btn">&larr; Главна платформа NAsvetlo</a>
      <a href="#invCrossSection" class="btn topbar-btn">Кръстосани разследвания ({fmtInt(sumInv.totalCrossLinkedRegistries || 11)})</a>
      <a href="#invAudit50Section" class="btn topbar-btn">Одит НАсветло 50 ({fmtInt(sum50.totalAdministrations || 50)} институции)</a>
    </div>
  </section>

  <section class="inv-kpi-grid" aria-label="Ключови показатели от новите разследвания">
    <div class="inv-kpi-card accent-crimson" data-jump-status="CLOSED_BLOCKED">
      <div class="inv-kpi-val">{bbCount} кутии</div>
      <div class="inv-kpi-lbl">0 масива в data.egov.bg</div>
      <div class="inv-kpi-sub">{fmtEurShort(sum50.blackBoxZeroDataEur)} ресурс без отворени данни</div>
    </div>
    <div class="inv-kpi-card accent-crimson" data-jump-tab="blackbox">
      <div class="inv-kpi-val">{fmtInt(sumInv.blackBoxTotalSingleOfferCount)}</div>
      <div class="inv-kpi-lbl">Договори с 1 оферта (Топ 12)</div>
      <div class="inv-kpi-sub">{fmtEurShort(sumInv.blackBoxTotalSingleOfferEur)} без реална конкуренция</div>
    </div>
    <div class="inv-kpi-card accent-ochre" data-jump-tab="mvr">
      <div class="inv-kpi-val">{fmtInt(sumInv.mvrExplicitRevokedNoActive)} отнети</div>
      <div class="inv-kpi-lbl">МВР ЗЧОД без активен лиценз в ЗОП</div>
      <div class="inv-kpi-sub">{fmtInt(sumInv.mvrSecurityContractNoActiveCount)} преки охранителни ({fmtEurShort(sumInv.mvrSecurityContractNoActiveEur)})</div>
    </div>
    <div class="inv-kpi-card accent-teal" data-jump-tab="concessions">
      <div class="inv-kpi-val">{fmtInt(sumInv.meConcessionsZopCompanies)} фирми</div>
      <div class="inv-kpi-lbl">Кариери (МЕ) × Строители по ЗОП</div>
      <div class="inv-kpi-sub">{fmtEurShort(sumInv.meConcessionsDirectEur)} + {fmtEurShort(sumInv.meConcessionsConsortiumEur)} ДЗЗД</div>
    </div>
    <div class="inv-kpi-card accent-ochre" data-jump-tab="dnsk">
      <div class="inv-kpi-val">{fmtInt(sumInv.dnskExpiredInZop)} / {fmtInt(sumInv.dnskIllegalInProcedure)}</div>
      <div class="inv-kpi-lbl">Изтекъл надзор (ЗУТ) / Висящи събаряния</div>
      <div class="inv-kpi-sub">От общо {fmtInt(sumInv.dnskIllegalOrdersTotal)} заповеди на ДНСК</div>
    </div>
    <div class="inv-kpi-card accent-teal" data-jump-tab="reserve">
      <div class="inv-kpi-val">{String(sumInv.mfPvExecutionPct || 76.09).replace('.', ',')}% ПВУ</div>
      <div class="inv-kpi-lbl">{fmtEurShort(sumInv.mfPvPaidEur)} от {fmtEurShort(sumInv.mfPvBudgetEur)}</div>
      <div class="inv-kpi-sub">Финансово изпълнение МФ към 30.09.2026</div>
    </div>
  </section>

  <!-- SECTION 1: LIVE CROSS-LINKED REGISTRIES -->
  <section id="invCrossSection">
    <div class="inv-section-header">
      <h2>1. Живи кръстосани разследвания (Отворени регистри × ЗОП)</h2>
      <span class="inv-section-meta" id="crossSectionMeta">Източник: data.egov.bg + NAsvetlo (17 428 фирми / 206 907 договора)</span>
    </div>

    <div class="inv-tabs" id="invTabBar" role="tablist" aria-label="Избор на живо разследване">
      <button type="button" class="inv-tab-btn active" data-inv-tab="overview">Акценти &amp; Резюме</button>
      <button type="button" class="inv-tab-btn" data-inv-tab="mvr">МВР (ЗЧОД) × Охрана <span class="inv-tab-count">{fmtInt(sumInv.mvrSecurityZopCompanies)}</span></button>
      <button type="button" class="inv-tab-btn" data-inv-tab="concessions">МЕ Кариери × Строители <span class="inv-tab-count">{fmtInt(sumInv.meConcessionsZopCompanies)}</span></button>
      <button type="button" class="inv-tab-btn" data-inv-tab="dnsk">ДНСК Надзор &amp; Незаконни строежи <span class="inv-tab-count">{fmtInt(sumInv.dnskConsultantsZopCompanies)}</span></button>
      <button type="button" class="inv-tab-btn" data-inv-tab="iaaa">ИААА Транспорт × ЗОП <span class="inv-tab-count">{fmtInt(sumInv.iaaaTransportZopCompanies)}</span></button>
      <button type="button" class="inv-tab-btn" data-inv-tab="reserve">Резерв, ПВУ, БАБХ &amp; Хазарт</button>
      <button type="button" class="inv-tab-btn" data-inv-tab="blackbox">Черни кутии (1 оферта)</button>
    </div>

    <div class="inv-panel-box" id="invCrossBody">
      <p style="color:var(--ink-muted);margin:0;">Зареждане на верифицираните разследвания…</p>
    </div>
  </section>

  <!-- SECTION 2: AUDIT OF ALL 50 ADMINISTRATIONS -->
  <section id="invAudit50Section">
    <div class="inv-section-header">
      <h2>2. Одит НАсветло 50: Прозрачност и корупционен риск на 50-те институции</h2>
      <span class="inv-section-meta">Общо проверени в data.egov.bg &amp; официални портали: {fmtInt(sum50.totalAdministrations || 50)} ({fmtEurShort(sum50.totalAuditZopEur)} по ЗОП)</span>
    </div>

    <div class="inv-tabs" id="audit50StatusBar" role="tablist" aria-label="Филтър по статус на прозрачност">
      <button type="button" class="inv-tab-btn active" data-status-filter="ALL">Всички <span class="inv-tab-count">50</span></button>
      <button type="button" class="inv-tab-btn" data-status-filter="CLOSED_BLOCKED">Черни кутии (0 масива) <span class="inv-tab-count">{bbCount}</span></button>
      <button type="button" class="inv-tab-btn" data-status-filter="OPENWASHING_COSMETIC">Фасадна прозрачност <span class="inv-tab-count">{owCount}</span></button>
      <button type="button" class="inv-tab-btn" data-status-filter="OPEN_READY_FOR_LINK">Готови за свързване <span class="inv-tab-count">{readyCount}</span></button>
      <button type="button" class="inv-tab-btn" data-status-filter="PARTIAL_FRAGMENTED">Замръзнали (2018–2024) <span class="inv-tab-count">{frozenCount}</span></button>
      <button type="button" class="inv-tab-btn" data-status-filter="CONNECTED_IN_NASVETLO">Свързани в NAsvetlo <span class="inv-tab-count">{connCount}</span></button>
    </div>

    <div class="inv-panel-box">
      <div class="inv-filter-toolbar">
        <input type="search" id="audit50Search" class="inv-input" placeholder="Търсене по институция, ЕИК, корупционна схема или ключов регистър…" />
        <select id="audit50Cluster" class="inv-select" aria-label="Филтър по ресорен клъстер">
          <option value="ALL">Всички ресорни клъстери</option>
        </select>
        <select id="audit50Sort" class="inv-select" aria-label="Сортиране">
          <option value="priority">Приоритет „Черна кутия“</option>
          <option value="spent">Ресурс по ЗОП (€)</option>
          <option value="exposure">Корупционна експозиция (0–100)</option>
          <option value="open">Отворени данни рейтинг (0–100)</option>
        </select>
      </div>

      <div id="audit50CountMeta" style="font-size:0.78rem;color:var(--ink-muted);margin-bottom:10px;"></div>

      <div class="inv-table-wrap">
        <table class="inv-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Институция &amp; ЕИК</th>
              <th>Ресор / Статус в NAsvetlo</th>
              <th class="num">ЗОП (€)</th>
              <th class="num">Масиви (data.egov.bg)</th>
              <th class="num">Корупц. риск</th>
              <th>Ключова бариера / Какво липсва</th>
            </tr>
          </thead>
          <tbody id="audit50Tbody">
            <tr><td colspan="7" style="text-align:center;color:var(--ink-muted);padding:20px;">Зареждане на одита на 50-те институции…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
