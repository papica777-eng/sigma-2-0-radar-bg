              </button>
            </div>
            <div id="svetWasmVerifyOutput" hidden></div>
            <div class="svet-wasm-calc">
              <span class="mono" style="font-size:0.74rem;font-weight:700;">Custom Row Test:</span>
              <label>k <input type="number" id="svetCalcK" value="345" min="1" /></label>
              <label>n <input type="number" id="svetCalcN" value="789" min="1" /></label>
              <label>Expected <input type="number" id="svetCalcExp" value="60.69" step="0.01" min="0.01" /></label>
              <label>Tests <input type="number" id="svetCalcTests" value="62166" min="1" /></label>
              <button type="button" class="btn" id="svetCalcRunBtn">Compute p &amp; q</button>
            </div>
            <div id="svetCalcOut" hidden></div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;">
