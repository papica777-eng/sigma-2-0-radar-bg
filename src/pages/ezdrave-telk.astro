---
import BaseLayout from '../layouts/BaseLayout.astro';
import telkRadarRaw from '../../docs/data/nasvetlo_telk_radar.json';

const asOf = String((telkRadarRaw as any).generatedAtUtc || '2026-11-24').slice(0, 10);
---

<BaseLayout
  title="еЗдраве · Експертни решения (ТЕЛК / НЕЛК) — Автоматична проверка и Публичен контрол"
  description="Интерактивен прототип в стила на еЗдраве (НЗИС) за автоматична проверка на издадени експертни решения (ЕР) на ТЕЛК, валидни документи и документи с несъответствия, и подаване на сигнал по реда на Публичен контрол."
  asOf={asOf}
  subpage={true}
  canonicalPath="/ezdrave-telk.html"
  subpageScript="sigma3/ezdrave_telk_demo.js?v=20261125a"
  subpageSyncHref="data/nasvetlo_telk_radar.json"
>
  <div class="ez-page-wrap">
    <div class="ez-back-bar">
      <a href="/telk-skener.html" class="btn topbar-btn">&larr; Обратно към ТЕЛК Скенер (национален радар и анализ)</a>
      <span class="mono" style="font-size: 0.78rem; color: var(--ink-muted);">
        Официална демонстрация · Тестово изпитание с 1 000 реални дела преди внедряване в Държавния облак
      </span>
    </div>

    <div class="ez-shell" id="ezPortalRoot" aria-label="еЗдраве — Модул Експертни решения (ТЕЛК / НЕЛК)">
      <header class="ez-topbar">
        <div class="ez-brand">
          <div class="ez-brand__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 2L4 5.5V11.2C4 16.5 7.4 21.1 12 22.5C16.6 21.1 20 16.5 20 11.2V5.5L12 2Z"
                stroke="white"
                stroke-width="1.8"
                fill="rgba(255,255,255,0.14)"
              />
              <path d="M12 7.5V15.5M8 11.5H16" stroke="white" stroke-width="2.2" stroke-linecap="round" />
            </svg>
          </div>
          <div>
            <h1 class="ez-brand__title">
              еЗдраве · Експертни решения (ТЕЛК / НЕЛК)
              <span class="ez-brand__badge">Защитена локална проверка (без съхранение на лични данни)</span>
            </h1>
            <p class="ez-brand__sub">
              Национална здравноинформационна система (his.bg) · Автоматична проверка на електронния подпис и медицинските данни
            </p>
          </div>
        </div>

        <div class="ez-topbar__actions">
          <span class="ez-eauth-pill" title="Идентификация чрез националния модул за електронна автентикация (еАвт)">
            <span class="ez-eauth-pill__dot" aria-hidden="true"></span>
            Вход с електронен подпис или мобилно приложение (еАвт)
          </span>

          <div class="ez-view-toggle" role="group" aria-label="Режим на преглед">
            <button type="button" class="is-active" data-ez-view="desktop">Портал (his.bg)</button>
            <button type="button" data-ez-view="mobile">Мобилно (еЗдраве)</button>
          </div>
        </div>
      </header>

      <div class="ez-kpi-strip" aria-label="Основни показатели за надеждност и защита">
        <div class="ez-kpi">
          <div class="ez-kpi__val">10 / 10 (100%)</div>
          <div class="ez-kpi__lbl">Точност при проверка на реални и отменени решения</div>
        </div>
        <div class="ez-kpi">
          <div class="ez-kpi__val">0% грешки</div>
          <div class="ez-kpi__lbl">0% грешки при реални пациенти</div>
        </div>
        <div class="ez-kpi">
          <div class="ez-kpi__val">Автоматична проверка</div>
          <div class="ez-kpi__lbl">Проверка на електронния подпис и медицинските данни</div>
        </div>
        <div class="ez-kpi">
          <div class="ez-kpi__val">Задължителен лекарски контрол</div>
          <div class="ez-kpi__lbl">Предварителна оценка (при риск се насрочва контролен преглед в НЕЛК)</div>
        </div>
      </div>

      <div class="ez-workspace" id="ezWorkspace">
        <aside class="ez-sidebar" aria-label="Списък с издадени експертни решения">
          <h2 id="ezListHeading">Издадени експертни решения (ЕР) — 10</h2>
          <div class="ez-filter-pills" role="tablist" aria-label="Филтър по статус">
            <button type="button" class="is-active" data-ez-filter="ALL">Всички (10)</button>
            <button type="button" data-ez-filter="AUTHENTIC">Валидни документи (5)</button>
            <button type="button" data-ez-filter="FRAUDULENT_ANNULLED">Документи с несъответствия (5)</button>
          </div>
          <div class="ez-case-list" id="ezCaseList"></div>
        </aside>

        <section class="ez-detail-wrap" id="ezDetailWrap" aria-live="polite"></section>
      </div>
    </div>

    <details style="margin-top: 1rem; font-size: 0.78rem; color: var(--ink-muted); background: var(--surface, rgba(15,23,42,0.04)); border: 1px solid var(--border, rgba(148,163,184,0.25)); border-radius: 10px; padding: 0.65rem 1rem;">
      <summary style="cursor: pointer; font-weight: 600;">Техническа информация за разработчици и одитори (НЗИС / „Информационно обслужване“ АД / МЕУ)</summary>
      <p style="margin: 0.55rem 0 0; line-height: 1.5;">
        Вътрешно ядро на затвореното хранилище <code>telk-verifier-sovereign</code> (за безвъзмездно дарение след тестово изпитание с 1 000 реални дела):
        <strong>Rust / WebAssembly</strong> + <strong>Zig 0.15.2 SIMD (Int8)</strong> + <strong>Mojo калибратор</strong> (<code>0</code> хост импорти, <code>0</code> външни мрежови заявки,
        защитена държавна сървърна среда / Държавен облак). Статуси на проверката: <code>АВТЕНТИЧЕН</code> · <code>СЪМНИТЕЛЕН — АНОМАЛИЯ</code> · <code>ФАЛШИВ / МАНИПУЛИРАН</code>.
      </p>
    </details>
  </div>

  <!-- Interactive "Публичен контрол" (eZdrave) Signal Modal -->
  <div class="ez-modal-backdrop" id="ezPkModal" role="dialog" aria-modal="true" aria-labelledby="ezPkTitle" hidden>
    <div class="ez-modal">
      <div class="ez-modal__head">
        <h3 id="ezPkTitle">Подай сигнал по реда на „Публичен контрол“ (еЗдраве)</h3>
        <button type="button" id="ezPkClose" aria-label="Затвори">&times;</button>
      </div>
      <div class="ez-modal__body">
        <p id="ezPkIntro" style="margin: 0; color: #52687c;"></p>

        <div class="ez-modal__field">
          <label for="ezPkTarget">Адресати на сигнала</label>
          <select id="ezPkTarget">
            <option>ИАМН + НЕЛК + НЗОК (чрез модул „Публичен контрол“ на еЗдраве)</option>
            <option>НЕЛК — искане за контролен преглед от комисия в друга област</option>
            <option>НЗОК + ИАМН — неизвършено изследване или несъответствие в НЗИС</option>
          </select>
        </div>

        <div class="ez-modal__field">
          <label for="ezPkCategory">Установено несъответствие</label>
          <select id="ezPkCategory"></select>
        </div>

        <div class="ez-modal__field">
          <label for="ezPkComment">Допълнително описание (без въвеждане на ЕГН)</label>
          <textarea id="ezPkComment" rows="3"></textarea>
        </div>

        <div class="ez-sandbox-notice" role="note">
          <strong>Гаранция за защита на личните данни (GDPR):</strong> В демонстрационния режим системата генерира
          защитен код за проверка локално на Вашето устройство без изпращане на данни. При внедряване в защитената
          държавна сървърна среда (Държавен облак) сигналът се насочва за проверка от лекарски състав на НЕЛК / ИАМН.
        </div>

        <div class="ez-modal__receipt" id="ezPkReceipt" hidden></div>

        <div class="ez-modal__actions" id="ezPkActions">
          <button type="button" class="ez-btn-secondary" id="ezPkCancel">Отказ</button>
          <button type="button" class="ez-btn-control" id="ezPkSubmit">Подай сигнал (демонстрация)</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
