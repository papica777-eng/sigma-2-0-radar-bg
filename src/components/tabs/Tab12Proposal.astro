---
import f7Raw from '../../../docs/data/sigma3_forensics_7.json';
import j6Raw from '../../../docs/data/sigma3_judicial_6.json';
import invRaw from '../../../docs/data/nasvetlo_investigations.json';

const e1: any = (f7Raw as any).engine1_annexInflation || {};
const annexTotalLabel = '+€' + (Number(e1.totalInflationEur || 1290789382.76) / 1e9).toFixed(2).replace('.', ',') + ' млрд.';
const annexProbedCount = Number(e1.probedCount || 165);
const asOfDate = [
  String((j6Raw as any).generatedAtUtc || '').slice(0, 10),
  String((invRaw as any).generatedAtUtc || '').slice(0, 10),
  '2026-11-22',
].filter(Boolean).sort().pop() || '2026-11-22';

const PROPOSAL_ROWS = [
  ['Обхват на обединения по ЗЗД (ДЗЗД)', 'Свързва директни договори по ЕИК (обединенията по ЗЗД нямат собствен ЕИК)', 'Пълно разбиване на 3 427 обединения по ЗЗД → разкрива +€1,92 млрд. при 76 лица', '+€1,92 млрд. нова видимост'],
  ['Декларации пред Сметната палата', 'Покрива основния регистър за дялови участия (ООД/ЕООД)', 'Обхваща всички таблици: частни заеми (Табл. 6/7), акции в АД (Табл. 9), Табл. 11 и чл. 35', '+26 допълнителни връзки / 16 лица'],
  ['Действителни собственици на консорциуми', 'Показва наименованието на обединението от договора', 'Разбива Топ 23 консорциума (≥€25 млн.) с актуални партиди от ТР, ЗМИП бенефициенти и холдинги', 'Двустепенно корпоративно разкриване'],
  ['Интелигентен AI асистент на български', 'Изисква външен платен AI ключ за активация', 'NAsvetlo ORACLE работи автономно със 100% непрекъсваемост (<5 ms, €0 разход, без външни сървъри)', '€0/мес. оперативен разход'],
  ['Публичен индекс на риска (0–100)', 'Предвиден за следващ етап в пътната карта', 'Прозрачен 6-факторен индекс за всички 571 лица, 4 344 възложители и 28 области', 'Готов за директно внедряване'],
  ['Детектор за картели (Co-Bidding)', 'Предвиден за следващ етап в пътната карта', 'Автоматична ДЗЗД матрица: 60 повтарящи се двойки + 40 водещи хъба (до 55× множител)', 'Национален антикартелен радар'],
  ['Статистически одит (Бенфорд / Джини)', 'Извън базовия визуален слой', 'Тест на Бенфорд (Nigrini MAD 0,0122 при възложители) + Лоренц/Парето (Топ 1% = 48,3%)', 'Количествен одитен контрол'],
  ['Карта на 28-те области (NUTS-3)', 'Визуализира общия обем на разходите по области', '5-слоен рисков атлас: разходи, риск, самовъзлагане, свързани лица и обединения по ЗЗД', '5× по-дълбок регионален срез'],
  ['Институционален граф на връзките', 'Локален преглед около единичен субект', '9-типов граф (+3 нови: Съдебно дело, Адвокат, Вещо лице) + Алгоритъм за най-кратка връзка', '9-слоен мрежов анализ'],
  ['Хронология „Мандат vs. Договори“', 'Списъчен преглед на договори и мандати', 'Интерактивна 8-годишна диаграма (2019–2026) с автоматични маркери за припокриване', 'Мигновена визуална верификация'],
  ['Удостоверяване на договор в реално време', 'Препраща към външна страница за всеки договор', 'Директно удостоверяване в ЦАИС ЕОП / СИГМА (анекси, оферти, CPV кохорти) в същия екран', 'Мигновен одит без напускане'],
  ['Експорт на официална справка / сигнал', 'Експорт на сурови таблични данни (CSV)', '1-клик генератор на структурирана справка за АДФИ / КПК / Сметна палата / EPPO (MD + PDF)', 'Готовност за контролни органи'],
  ['Глобално търсене по всички регистри', 'Сървърна заявка при всяко търсене', 'Ctrl+K мигновен индекс през 22 343 записа (571 лица + 4 344 инст. + 17 428 фирми)', '<10 ms време за реакция'],
  ['Йерархичен профил на концентрацията', 'Няма обобщена йерархична класация Топ 50', '5-режимна интерактивна йерархия Топ 50 (СИГМА+ДЗЗД, Самовъзлагане, Мандат, ДЗЗД, Риск)', 'Ясна управленска картина'],
  ['Радар 1: Анекси и оскъпяване (Post-Award)', 'Отбелязва единични модификации по договор', `Автоматично проследяване Подписана → Крайна цена (${annexTotalLabel} доказани анекси при ${annexProbedCount} договора)`, 'Контрол върху оскъпяването'],
  ['Радар 2: Новосъздадени и „кухи“ фирми', 'Извън базовия обхват на ЦАИС ЕОП', 'Автоматична проверка в Търговския регистър (регистрация, капитал, ГФО) и съотношение Поръчки/Капитал', 'Превенция на фирми без капацитет'],
  ['Радар 3: Разделяне под прага (Salami)', 'Извън базовия обхват', '60-дневен плъзгащ алгоритъм върху 206 907 договора → 2 155 клъстера (1 776 не-фарма за €214M+)', 'Контрол по чл. 20–21 ЗОП'],
  ['Радар 4: Политически дарения (ЕРИК) и Медии', 'Извън базовия обхват', 'Кръстосана връзка с ЕРИК (2023–2026: 3 716 дарители, 152 партийни PR агенции за €291M + 1 130 медийни дог.)', 'Прозрачност на финансирането'],
  ['Радар 5: Времеви аномалии (Ное–Дек)', 'Извън базовия обхват', 'Анализ по дни от седмицата, 20–31 декември и 141 институции с концентрация ≥32% в края на годината', 'Контрол на бюджетното усвояване'],
  ['Радар 6: Картелна ротация и общ адрес', 'Извън базовия обхват', '430 ротационни пръстена (A→B→C→A) + клъстери по общ адрес и собственици в Търговския регистър', 'Антикартелен контрол (ЗЗК)'],
  ['Радар 7: Ограничителни клаузи (чл. 49 ЗОП)', 'Извън базовия обхват', 'Национален скан (661 марково заключени договора за €240M) + Интерактивен одитор на тръжни условия', 'Превенция преди обявяване'],
  ['Съдебен 1: Търговски спорове и спогодби', 'Извън базовия обхват', '28 реални ТД/ВТД дела Възложител ↔ Изпълнител от ЕПЕП (0 дела по чл. 155 ТЗ) + Матрица Анекси × КЗК/АДФИ', 'Контрол върху съдебни спогодби'],
  ['Съдебен 2: Индекс на безнаказаността (АДФИ)', 'Извън базовия обхват', 'Автоматична синхронизация на всички 2 229 доклада на АДФИ (2024–2026) + 370 по чл. 17(7) + 28 КАНД решения', 'Проследяемост на санкциите'],
  ['Съдебен 3: Адвокати и Вещи лица', 'Извън базовия обхват', 'Мулти-институционални кантори + 90 процесуални представители от ЕПЕП + 107 АДФИ вещи лица', 'Прозрачност на правната защита'],
  ['Съдебен 4: Предварително изпълнение (КЗК/ВАС)', 'Извън базовия обхват', 'Автоматична синхронизация от reg.cpc.bg (1 032 дела 2026) + 30 окончателни акта на ВАС IV отд.', 'Контрол върху обжалванията'],
  ['Съдебен 5: Несъстоятелност и „Феникс“ фирми', 'Извън базовия обхват', 'Проверка в Търговския регистър за запори, особени залози, 79 дружества в дългов срив и „Феникс“ вериги', 'Защита от неизпълнение и дългове'],
  ['Съдебен 6: ЗМИП и EPPO рисков профил', 'Извън базовия обхват', 'Радар на ЕС средства по Регл. (ЕС) 2017/1939 + ЗМИП проверка + автоматичен флаг чл. 54, ал. 1 ЗОП', 'Защита на европейските фондове'],
];
---
<!-- =================================================================== -->
<!-- TAB 12: EXECUTIVE ARCHITECTURE & MINISTERIAL BRIEFING (MIDT)        -->
<!-- =================================================================== -->
<section class="tab-panel" id="tab-proposal" hidden>
  <!-- Print-Only Official Ministerial 1-2 Page Executive Header with Logo & Scannable QR Code -->
  <div class="print-executive-header" aria-hidden="true">
    <div class="print-exec-brand">
      <img src="/logo-icon.png" alt="NAsvetlo" width="52" height="52" />
      <div>
        <div class="print-exec-kicker">ОФИЦИАЛНО РЕЗЮМЕ ЗА МИДТ · НАДГРАЖДАЩ АНАЛИТИЧЕН СЛОЙ</div>
        <h1 class="print-exec-title">NAsvetlo — Надграждане на прозрачността върху СИГМА 2.0</h1>
        <div class="print-exec-meta">Жива демонстрационна платформа: <strong>https://nasvetlo.website/</strong> · Данни към: <strong>{asOfDate}</strong> · Лиценз: MIT / CC-BY 4.0</div>
      </div>
    </div>
    <div class="print-exec-qr">
      <img
        src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&margin=2&data=https%3A%2F%2Fnasvetlo.website%2F"
        alt="QR код към https://nasvetlo.website/"
        width="84"
        height="84"
      />
      <span>nasvetlo.website</span>
    </div>
  </div>

  <div class="proposal-hero">
    <div>
      <div class="hero-kicker">НЕЗАВИСИМ ГРАЖДАНСКИ ОДИТЕН СЛОЙ · ПАРТНЬОРСКО ПРЕДЛОЖЕНИЕ КЪМ МИДТ</div>
      <h2 style="font-family:var(--font-serif);font-size:clamp(22px,2.8vw,32px);margin:0 0 8px;">
        NAsvetlo — Надграждащ аналитичен слой върху отворените данни на <code>sigma.midt.bg</code>
      </h2>
      <p style="margin:0;color:var(--ink-secondary);max-width:78ch;">
        Платформата на <strong>nasvetlo.website</strong> е напълно работещ, възпроизводим надграждащ модул, изграден директно върху отворената архитектура и данните (MIT / CC-BY 4.0) на <strong>МИДТ / СИГМА 2.0</strong>. Тя разширява базовия регистър с готови за внедряване модули за обединения по ЗЗД, картелни модели, съдебен контрол и автономен AI асистент без оперативни разходи за държавата.
      </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button class="btn btn-dark" id="btnPrintProposal" type="button">Официално резюме за МИДТ (PDF)</button>
      <button class="btn" id="btnDownloadProposalMd" type="button">Изтегли Меморандум (.md)</button>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card emphasis">
      <div class="kpi-label">Допълнителна видимост (ДЗЗД)</div>
      <div class="kpi-val">+€1,92 млрд.</div>
      <div class="kpi-sub">338 обединения по ЗЗД на 76 лица, разбити до реалните участници</div>
    </div>
    <div class="kpi-card emphasis">
      <div class="kpi-label">Анекси и оскъпяване</div>
      <div class="kpi-val">{annexTotalLabel}</div>
      <div class="kpi-sub">Проследено оскъпяване при {annexProbedCount} детайлно одитирани договора</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Картелен и статистически одит</div>
      <div class="kpi-val">60 двойки + Бенфорд</div>
      <div class="kpi-sub">3 427 ДЗЗД анализирани · Nigrini MAD · Gini 0,906</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Оперативен разход за държавата</div>
      <div class="kpi-val">€0 / мес. AI</div>
      <div class="kpi-sub">100% непрекъсваемост · Готов модул за директно внедряване</div>
    </div>
  </div>

  <div class="panel-box" style="margin-bottom:18px;">
    <h3>Сравнителна архитектура: Базов слой (СИГМА 2.0) &rarr; Надграждащ аналитичен слой (NAsvetlo)</h3>
    <div class="table-wrap" style="border:none;">
      <table>
        <thead>
          <tr>
            <th>Функционално измерение</th>
            <th>Базов слой (СИГМА 2.0)</th>
            <th>Надграждащ аналитичен слой (NAsvetlo)</th>
            <th>Ефект за държавния контрол</th>
          </tr>
        </thead>
        <tbody id="proposalMatrixTbody">
          {PROPOSAL_ROWS.map((r) => (
            <tr style="cursor:default;">
              <td><strong>{r[0]}</strong></td>
              <td class="muted">{r[1]}</td>
              <td>{r[2]}</td>
              <td><span class="tag tag-teal">{r[3]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="two-col">
    <div class="panel-box">
      <h3>Готов модул за директно внедряване в архитектурата на МИДТ</h3>
      <ul class="clean-list">
        <li><strong>Пълна съвместимост без разход за сървъри:</strong> Всички одитни модули (разбиване на обединения по ЗЗД, картелна матрица, тест на Бенфорд, съставен индекс на риска) се изпълняват като детерминистични стъпки върху съществуващата инфраструктура на МИДТ без допълнителен хардуер.</li>
        <li><strong>Автономен AI асистент със 100% непрекъсваемост:</strong> <strong>NAsvetlo ORACLE</strong> работи локално без външни сървъри и без платен AI ключ — отговаря за &lt;5 ms на разговорен български език, съкращения и латиница, без изтичане на данни и с 0% риск от халюцинация.</li>
        <li><strong>4-степенен одитен филтър (нулеви фалшиви съвпадения):</strong> (1) тройна корпоративна и декларативна верификация в Търговския регистър; (2) автоматично изключване на служебни извън-ЗОП производства (искове на Прокуратурата по чл. 155 ТЗ, АВ, НАП, ГИТ); (3) географско заключване на едноименни обекти по регионални дирекции на АДФИ и съдебни райони; (4) пълно обезличаване на лични данни по ЗЗЛД/GDPR.</li>
        <li><strong>Отворени лицензи и правна инвариантност:</strong> MIT код + CC-BY 4.0 отворени данни (ЗОП, чл. 75 ЗСП, ЗДФИ, ЗПК, ЗТРРЮЛНЦ) и ясно разграничение между публичен статистически индикатор и съдебен акт.</li>
      </ul>
    </div>
    <div class="panel-box">
      <h3>Методология, възпроизводимост и източници (актуализация 2026 г.)</h3>
      <ul class="clean-list">
        <li><strong>Базов масив:</strong> Отворени данни (CC-BY 4.0) от <a href="https://sigma.midt.bg" target="_blank" rel="noopener">sigma.midt.bg</a> на <strong>МИДТ</strong> и <strong>АОП / ЦАИС ЕОП</strong> (<a href="https://eop.bg" target="_blank" rel="noopener">eop.bg</a> — 206 907 договора, 4 344 възложители, 17 428 фирми и обединения по ЗЗД, 83 месеца, 28 области NUTS-3).</li>
        <li><strong>Институционални и съдебни регистри (2026 г.):</strong> <strong>Сметна палата на РБ</strong> (<a href="https://register.cacbg.bg" target="_blank" rel="noopener">register.cacbg.bg</a> — 3 035 декларации и <strong>ЕРИК</strong>), <strong>КПК</strong> (Комисия за противодействие на корупцията), <strong>АДФИ</strong> (<a href="https://adfi.minfin.bg" target="_blank" rel="noopener">adfi.minfin.bg</a> — 2 229 доклада и 370 актуализации по чл. 17, ал. 7 ЗДФИ), <strong>КЗК</strong> (<a href="https://reg.cpc.bg" target="_blank" rel="noopener">reg.cpc.bg</a>), <strong>ВСС — ЕПЕП / ЕИСС</strong> (<a href="https://ecase.justice.bg" target="_blank" rel="noopener">ecase.justice.bg</a> и <strong>ВАС — Четвърто отделение</strong>), <strong>ТРРЮЛНЦ</strong> и <strong>Европейска прокуратура (EPPO)</strong> по Регламент (ЕС) 2017/1939.</li>
        <li><strong>Отворен код и проверка на синхронизацията:</strong> Целият изходен код е публично достъпен в <a href="https://github.com/papica777-eng/sigma-2-0-radar-bg" target="_blank" rel="noopener">GitHub хранилището на проекта</a>, а актуалната дата на синхронизация ({asOfDate}) се удостоверява директно в <a href="data/sigma3_judicial_6.json" target="_blank" rel="noopener">отворения регистър на актуализациите</a>.</li>
        <li><strong>Правна бележка:</strong> Всички данни са официално публични по силата на ЗОП, ЗСП, ЗДФИ, ЗПК и ЗТРРЮЛНЦ. Рисковите индекси, картелните двойки и статистическите индикатори служат за обективен обществен, институционален и одитен контрол и не представляват съдебно установена вина.</li>
      </ul>
    </div>
  </div>
</section>
