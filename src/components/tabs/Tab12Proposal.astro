---
import f7Raw from '../../../docs/data/sigma3_forensics_7.json';

const e1: any = (f7Raw as any).engine1_annexInflation || {};
const annexTotalLabel = '+€' + (Number(e1.totalInflationEur || 1290789382.76) / 1e9).toFixed(2).replace('.', ',') + ' млрд.';
const annexProbedCount = Number(e1.probedCount || 165);

const PROPOSAL_ROWS = [
  ['Обхват на консорциуми (ДЗЗД без ЕИК)', 'Пропуска договорите на политици през ДЗЗД, защото свързва само по ЕИК', 'Пълно разбиване на 3 427 ДЗЗД → разкрива +€1,92 млрд. при 76 лица', '+€1,92 млрд. нови разкрития'],
  ['XML декларации на Сметната палата', 'Чете основно Табл. 10 (ООД/ЕООД дялове)', 'Сканира всички таблици: Табл. 6/7 (частни заеми), Табл. 9 (акции АД), Табл. 11, Декл. чл. 35', '+26 пропуснати връзки / 16 нови лица'],
  ['Реални собственици на мега-консорциуми', 'Показва само текста на обединението', 'Разбива Топ 23 ДЗЗД (≥€25 млн.) с живи партиди от ТР, ЗМИП бенефициенти и холдинги-майки', '2-hop корпоративно разкриване'],
  ['AI Асистент на български език', 'Изключен в production (HTTP 503 без LLM ключ)', 'NAsvetlo ORACLE (семантично NLU + векторен RAG) работи 100% на живо (<5 ms, €0 разход, 0% халюцинации)', '0×503 · €0/мес. оперативен разход'],
  ['Публичен рисков индекс (0–100)', 'Липсва (отбелязан като „в плана за развитие“)', 'Прозрачен 6-факторен индекс за всички 571 лица, 4 344 възложители и 28 области', 'Готов за внедряване днес'],
  ['Детектор за картели (Co-Bidding)', 'Липсва (в бъдещата пътна карта)', 'Автоматична ДЗЗД матрица: 60 повтарящи се двойки + 40 сенчести хъба (до 55× множител)', 'Първи картелен радар в БГ'],
  ['Математически одит (Бенфорд / Джини)', 'Липсва', 'Тест на Бенфорд (Nigrini MAD 0,0122 при възложители) + Лоренц/Парето (Топ 1% = 48,3%)', 'Научна криминалистика'],
  ['Карта на 28-те области (GISCO NUTS-3)', 'Показва само сума на разходите', '5-слоен рисков атлас: разходи, риск, самовъзлагане, свързани лица и скрити ДЗЗД', '5× по-дълбок регионален срез'],
  ['Мрежов граф и търсене на връзки', '1-2 хопа около 1 фиксиран център', '9-типов граф (+3 нови: Съдебно дело, Адвокат, Вещо лице) + BFS най-кратък път + PNG експорт', '9-слойна графова криминалистика'],
  ['Хронология „Мандат vs. Договори“', 'Текстов списък без визуално наслагване', 'Интерактивна 8-годишна Gantt диаграма (2019–2026) с червени маркери за припокриване', 'Мигновена визуална верификация'],
  ['Жива проверка на договор (JSON)', 'Отваря нова страница за всеки договор', 'Интегриран CORS инспектор към /contracts/{id}.json (анекси, оферти, CPV p25–p99)', 'Мигновен одит без напускане'],
  ['Експорт на официален сигнал / справка', 'Няма (само суров CSV)', '1-клик генератор на юридическа справка за АДФИ / КПК (бивша КПКОНПИ) / Сметна палата / EPPO (MD + PDF)', 'Директна приложимост за контрол'],
  ['Глобално търсене (Omnibox)', 'Сървърна заявка с презареждане', 'Ctrl+K мигновен индекс през 22 343 записа (571 лица + 4 344 инст. + 17 428 фирми)', '<10 ms реакция'],
  ['Йерархичен профил на концентрацията (Топ 50)', 'Няма обобщена визуална йерархия', '5-режимна интерактивна йерархия Топ 50 (СИГМА+ДЗЗД, Самовъзлагане, Мандат, ДЗЗД, Риск)', 'Максимална одиторска яснота'],
  ['Радар 1: Анекси и оскъпяване (Post-Award)', 'Показва единични флагове без обща класация', `Автоматично проследяване Подписана → Крайна цена (${annexTotalLabel} доказани анекси при ${annexProbedCount} договора)`, 'Спира дъмпинг + анекс схеми'],
  ['Радар 2: „Кухи“ и новосъздадени фирми', 'Не проверява дата на регистрация / капитал / ГФО', 'Жив одит в Търговския регистър (регистрация, капитал, ГФО): дни до 1-ви договор и множител Поръчки/Капитал', 'Засича фирми-фантоми'],
  ['Радар 3: Разделяне под прага (Salami Slicing)', 'Липсва', '60-дневен плъзгащ алгоритъм върху 206 907 договора → 2 155 клъстера (1 776 не-фарма за €214M+)', 'Разкрива заобикаляне на ЗОП'],
  ['Радар 4: Политически дарения (ЕРИК) и Медии', 'Липсва', 'Жива връзка с ЕРИК (2023–2026: 3 716 дарители, 152 партийни PR агенции за €291M + 1 130 медийни дог.)', 'Разкрива „откупуване“ на поръчки'],
  ['Радар 5: Времеви аномалии (Петък / Ное–Дек)', 'Липсва', 'Анализ по дни от седмицата, 20–31 декември и 141 институции с Ное–Дек дъмпинг ≥32%', 'Контрол на бюджетния дъмпинг'],
  ['Радар 6: Картелна ротация и общ адрес (ТР)', 'Липсва', '430 ротационни пръстена (A→B→C→A) + клъстери по общ адрес и собственици в ТР', 'Антикартелен контрол (ЗЗК)'],
  ['Радар 7: NLP „Шити“ поръчки (чл. 49 ЗОП)', 'Липсва', 'Национален скан (661 марково заключени договора за €240M) + Жив интерактивен ЗОП NLP одитор', 'Превенция преди обявяване'],
  ['Съдебен 1: Търговски спорове и спогодби (ЕИСС)', 'Липсва', '28 реални ТД/ВТД дела Възложител ↔ Изпълнител от ЕПЕП (0 дела по чл. 155 ТЗ) + Матрица Анекси × КЗК/АДФИ', 'Пресича източване чрез спогодби'],
  ['Съдебен 2: Индекс на безнаказаността (АДФИ)', 'Липсва', 'Пълен жив инжест на всички 2 229 доклада на АДФИ (2024–2026) + 370 по чл. 17(7) + 28 КАНД решения от ЕПЕП', 'Реален одитен контрол'],
  ['Съдебен 3: Адвокати и Вещи лица (Legal Graph)', 'Липсва', 'Мулти-институционални кантори + 90 процесуални представители от ЕПЕП + 107 АДФИ вещи лица', 'Разкрива скрити правни мрежи'],
  ['Съдебен 4: Предварително изпълнение (КЗК/ВАС)', 'Липсва', 'Жив инжест от reg.cpc.bg (1 032 дела 2026) + 30 окончателни акта на ВАС IV отд. от ЕПЕП', 'Контрол върху спиранията'],
  ['Съдебен 5: Несъстоятелност и „Феникс“ фирми', 'Липсва', 'Жив одит в Търговския регистър за запори, особени залози, фирми в срив и „Феникс“ вериги', 'Спира „изгаряне“ с дългове'],
  ['Съдебен 6: ЗМИП и EPPO рисков профил', 'Липсва', 'Радар на ЕС средства по Регл. (ЕС) 2017/1939 + ЗМИП празноти + автоматичен флаг чл. 54, ал. 1 ЗОП', 'Защита на бюджета на ЕС'],
];
---
<!-- =================================================================== -->
<!-- TAB 12: OFFICIAL EXECUTIVE PROPOSAL TO MIDT (SIGMA 2.0 -> 3.0 FINALITY) -->
<!-- =================================================================== -->
<section class="tab-panel" id="tab-proposal">
  <div class="proposal-hero">
    <div>
      <div class="hero-kicker">НЕЗАВИСИМА ГРАЖДАНСКА ПЛАТФОРМА · ОТВОРЕНИ ДАННИ (CC-BY 4.0) НА МИДТ / СИГМА 2.0</div>
      <h2 style="font-family:var(--font-serif);font-size:clamp(22px,2.8vw,32px);margin:0 0 8px;">
        NAsvetlo — Независим граждански одитен слой и архитектурно предложение към <code>sigma.midt.bg</code>
      </h2>
      <p style="margin:0;color:var(--ink-secondary);max-width:78ch;">
        Платформата, която разглеждате на живо на <strong>nasvetlo.website</strong>, е независима гражданска платформа, изградена върху отворените данни (CC-BY 4.0) и MIT архитектурата на <code>midt-bg/sigma</code> (МИДТ / СИГМА 2.0). Тя решава четирите критични структурни дефицита на СИГМА 2.0 и реализира предварително модули за риск, картели, съдебни актове и AI асистент.
      </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button class="btn btn-dark" id="btnPrintProposal" type="button">Отпечатай / PDF Меморандум</button>
      <button class="btn" id="btnDownloadProposalMd" type="button">Изтегли Markdown (.md)</button>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card emphasis">
      <div class="kpi-label">Разкрит скрит обем (ДЗЗД)</div>
      <div class="kpi-val">+€1,92 млрд.</div>
      <div class="kpi-sub">338 консорциума без ЕИК на 76 лица, невидими в СИГМА 2.0</div>
    </div>
    <div class="kpi-card emphasis">
      <div class="kpi-label">Нови връзки от XML</div>
      <div class="kpi-val">26 връзки / 16 лица</div>
      <div class="kpi-sub">Табл. 6, 7 (заеми), Табл. 9 (акции АД), Декл. чл. 35</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Картелна и статистическа защита</div>
      <div class="kpi-val">60 двойки + Бенфорд</div>
      <div class="kpi-sub">3 427 ДЗЗД анализирани · Nigrini MAD · Gini 0,906</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Оперативен разход за държавата</div>
      <div class="kpi-val">€0 / мес. AI</div>
      <div class="kpi-sub">Клиентски 0-503 AI асистент + drop-in Cloudflare D1/Workers</div>
    </div>
  </div>

  <div class="panel-box" style="margin-bottom:18px;">
    <h3>Сравнителна матрица: СИГМА 2.0 (sigma.midt.bg) vs. NAsvetlo (nasvetlo.website)</h3>
    <div class="table-wrap" style="border:none;">
      <table>
        <thead>
          <tr>
            <th>Функционално измерение</th>
            <th>СИГМА 2.0 (МИДТ — текущо)</th>
            <th>NAsvetlo (nasvetlo.website — независим граждански слой)</th>
            <th>Измеримо предимство</th>
          </tr>
        </thead>
        <tbody id="proposalMatrixTbody">
          {PROPOSAL_ROWS.map((r) => (
            <tr style="cursor:default;">
              <td><strong>{r[0]}</strong></td>
              <td class="muted">{r[1]}</td>
              <td>{r[2]}</td>
              <td><span class="tag tag-teal">{r[3]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="two-col">
    <div class="panel-box">
      <h3>Drop-in интеграция в архитектурата на МИДТ (<code>midt-bg/sigma</code>)</h3>
      <ul class="clean-list">
        <li><strong>Пълна съвместимост с архитектурата на МИДТ:</strong> Всички одитни модули (разбиване на ДЗЗД, картелна матрица, тест на Бенфорд, съставен индекс на риска) се изпълняват като детерминистични стъпки върху публичните данни без допълнителен хардуер.</li>
        <li><strong>Нулева зависимост от платени LLM API (край на HTTP 503):</strong> Клиентският детерминистичен NLU &amp; векторен RAG модул <strong>NAsvetlo ORACLE</strong> отговаря за &lt;5 ms на български (и шльокавица) без токени, без изтичане на данни и с 0% риск от халюцинация — всяка цифра сочи към ЕИК, договор, съдебен акт или декларация.</li>
        <li><strong>Защита срещу фалшиви съвпадения (4-степенен одитен филтър):</strong> (1) тройна корпоративна и декларативна верификация (съвпадение на правна форма, седалище и ЕИК в Търговския регистър); (2) автоматично изключване на служебни извън-ЗОП производства (вкл. искове на Прокуратурата по чл. 155 ТЗ, АВ, НАП и ИА ГИТ = 0 фалшиви прокурорски дела); (3) географско заключване на едноименни обекти по регионални дирекции на АДФИ и съдебни райони (за едноименни училища, ДГ, читалища, МБАЛ и ВиК); (4) строго разделяне на директните ЕИК/УНП връзки от регионалните актуализации по чл. 17, ал. 7 ЗДФИ и пълно обезличаване на лични данни по ЗЗЛД/GDPR (0 открити ЕГН).</li>
        <li><strong>Отворени лицензи и правна инвариантност:</strong> MIT код + CC-BY 4.0 отворени данни (ЗОП, чл. 75 ЗСП, ЗДФИ, ЗПК, ЗТРРЮЛНЦ), WCAG 2.1 AA контраст и ясно разграничение между публичен статистически индикатор и съдебен акт.</li>
      </ul>
    </div>
    <div class="panel-box">
      <h3>Методология, възпроизводимост и източници (актуализация 2026 г.)</h3>
      <ul class="clean-list">
        <li><strong>Базов масив:</strong> Отворени данни (CC-BY 4.0) от <a href="https://sigma.midt.bg" target="_blank" rel="noopener">sigma.midt.bg</a> на <strong>МИДТ</strong> и <strong>АОП / ЦАИС ЕОП</strong> (<a href="https://eop.bg" target="_blank" rel="noopener">eop.bg</a> — 206 907 договора, 4 344 възложители, 17 428 фирми и ДЗЗД, 83 месеца, 28 области NUTS-3).</li>
        <li><strong>Институционални и съдебни регистри (2026 г.):</strong> <strong>Сметна палата на РБ</strong> (<a href="https://register.cacbg.bg" target="_blank" rel="noopener">register.cacbg.bg</a> — 3 035 декларации и <strong>ЕРИК</strong>), <strong>КПК</strong> (Комисия за противодействие на корупцията — след разделянето на КПКОНПИ на КПК и КОНПИ), <strong>АДФИ</strong> (<a href="https://adfi.minfin.bg" target="_blank" rel="noopener">adfi.minfin.bg</a> — 2 229 доклада и 370 актуализации по чл. 17, ал. 7 ЗДФИ), <strong>КЗК</strong> (<a href="https://reg.cpc.bg" target="_blank" rel="noopener">reg.cpc.bg</a>), <strong>ВСС — ЕПЕП / ЕИСС</strong> (<a href="https://ecase.justice.bg" target="_blank" rel="noopener">ecase.justice.bg</a> и <strong>ВАС — Четвърто отделение</strong>), <strong>Агенция по вписванията — ТРРЮЛНЦ</strong> (<a href="https://portal.registryagency.bg" target="_blank" rel="noopener">portal.registryagency.bg</a>) и <strong>Европейска прокуратура (EPPO)</strong> по Регламент (ЕС) 2017/1939.</li>
        <li><strong>Отворен код и проверка на синхронизацията:</strong> Целият изходен код и алгоритмите за синхронизация са публично достъпни за независима проверка в <a href="https://github.com/papica777-eng/sigma-2-0-radar-bg" target="_blank" rel="noopener">GitHub хранилището на проекта</a>, а актуалният час на последната синхронизация се удостоверява директно в <a href="data/sigma3_judicial_6.json" target="_blank" rel="noopener">отворения JSON регистър на актуализациите</a>.</li>
        <li><strong>Правна бележка:</strong> Всички данни са официално публични по силата на ЗОП, ЗСП, ЗДФИ, ЗПК и ЗТРРЮЛНЦ. Рисковите индекси, картелните двойки и статистическите индикатори служат за обективен обществен, институционален и одитен контрол и не представляват съдебно установена вина.</li>
      </ul>
    </div>
  </div>
</section>
