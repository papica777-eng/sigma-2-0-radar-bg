) : (
  <!-- Exact sigma.midt.bg hero-mark architecture: Large Projector on the Left Illuminating the 19-Scanline Map of Bulgaria on the Right -->
  <div class="hero-projector-mark-wrap" aria-hidden="true">
    <svg
      class="hero-mark"
      viewBox="0 0 165 115"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Прожектор, осветяващ картата на България"
    >
      <defs>
        <linearGradient id="heroBeamGrad" x1="0%" y1="50%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="#ac1b18" stop-opacity="0.22" />
          <stop offset="60%" stop-color="#ac1b18" stop-opacity="0.08" />
          <stop offset="100%" stop-color="#ac1b18" stop-opacity="0.0" />
        </linearGradient>
      </defs>

      <!-- Volumetric Searchlight Cone Projecting Across Bulgaria -->
      <polygon class="hero-beam-cone" points="50,36 156,6 156,90 50,60" fill="url(#heroBeamGrad)" />
      <line x1="50" y1="36" x2="152" y2="8" stroke="#ac1b18" stroke-width="1.4" stroke-dasharray="3 2.5" opacity="0.55" />
      <line x1="50" y1="60" x2="142" y2="87" stroke="#ac1b18" stroke-width="1.4" stroke-dasharray="3 2.5" opacity="0.55" />

      <!-- Sleek Minimalist Projector (Replacing the Magnifying Glass of sigma.midt.bg/hero-mark.png) -->
      <g class="hero-projector-body" fill="#d4d0cb">
        <!-- Rear Lamp Housing -->
        <rect x="3" y="37" width="13" height="22" rx="2.5" />
        <!-- Cooling Fins -->
        <rect x="18" y="33" width="4" height="30" rx="1" />
        <rect x="24" y="33" width="4" height="30" rx="1" />
        <!-- Conical Projector Head -->
        <path d="M 30 31 L 47 23.5 C 49.2 22.5 51 24 51 26.5 L 51 69.5 C 51 72 49.2 73.5 47 72.5 L 30 65 Z" />
        <!-- Active Glowing Vermilion Lens Aperture -->
        <rect x="50" y="26" width="3.5" height="44" rx="1.7" fill="#ac1b18" />
        <!-- Yoke & Handle/Stand at 45° (Matching sigma.midt.bg's iconic silhouette) -->
        <path d="M 21 65 L 21 75 C 21 78 23 80 26 80 L 36 80" fill="none" stroke="#d4d0cb" stroke-width="5.5" stroke-linecap="round" />
        <path d="M 27 78 L 5 105" fill="none" stroke="#d4d0cb" stroke-width="10.5" stroke-linecap="round" />
        <path d="M 27 78 L 41 105" fill="none" stroke="#d4d0cb" stroke-width="7.5" stroke-linecap="round" />
      </g>

