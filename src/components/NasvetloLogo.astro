---
interface Props {
  variant?: 'header' | 'hero';
}
const { variant = 'header' } = Astro.props;
const uid = variant === 'hero' ? 'nvHero' : 'nvHdr';
---
<div class={`nasvetlo-logo-wrap nasvetlo-logo-${variant}`} title="НА СВЕТЛО (nasvetlo.website) — Национален криминалистичен прожектор за обществени поръчки и скрити дивиденти">
  <svg
    class="nasvetlo-logo-svg"
    viewBox="0 0 120 120"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Лого НА СВЕТЛО — Прожектор в тъмното, осветяващ скрити дивиденти и парични потоци"
  >
    <defs>
      <!-- Deep Obsidian Vault Background -->
      <radialGradient id={`${uid}-vaultBg`} cx="35%" cy="30%" r="75%">
        <stop offset="0%" stop-color="#111a2e" />
        <stop offset="55%" stop-color="#070b14" />
        <stop offset="100%" stop-color="#03050a" />
      </radialGradient>

      <!-- Metallic Bezel Gradient -->
      <linearGradient id={`${uid}-bezelGrad`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fbbf24" />
        <stop offset="35%" stop-color="#38bdf8" />
        <stop offset="70%" stop-color="#1e293b" />
        <stop offset="100%" stop-color="#f59e0b" />
      </linearGradient>

      <!-- Volumetric Searchlight Cone (Outer Warm Gold + Cyan Forensic Spectrum) -->
      <linearGradient id={`${uid}-beamOuter`} x1="16%" y1="16%" x2="88%" y2="88%">
        <stop offset="0%" stop-color="#fef08a" stop-opacity="0.92" />
        <stop offset="22%" stop-color="#fbbf24" stop-opacity="0.58" />
        <stop offset="58%" stop-color="#38bdf8" stop-opacity="0.26" />
        <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
      </linearGradient>

      <!-- Inner High-Lumen Core Beam -->
      <linearGradient id={`${uid}-beamCore`} x1="18%" y1="18%" x2="82%" y2="82%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.98" />
        <stop offset="30%" stop-color="#fde047" stop-opacity="0.65" />
        <stop offset="70%" stop-color="#fbbf24" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.0" />
      </linearGradient>

      <!-- Gold Bullion / Dividend Bar Gradient -->
      <linearGradient id={`${uid}-goldBar`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#fef08a" />
        <stop offset="45%" stop-color="#f59e0b" />
        <stop offset="100%" stop-color="#b45309" />
      </linearGradient>

      <!-- Emerald Dividend Growth Gradient -->
      <linearGradient id={`${uid}-emeraldBar`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#6ee7b7" />
        <stop offset="50%" stop-color="#10b981" />
        <stop offset="100%" stop-color="#047857" />
      </linearGradient>

      <!-- Soft Glow Filter -->
      <filter id={`${uid}-glow`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="2.6" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>

      <!-- Clip Path for the Circular Vault -->
      <clipPath id={`${uid}-vaultClip`}>
        <circle cx="60" cy="60" r="54" />
      </clipPath>
    </defs>

    <!-- Outer Forensic Radar Bezel -->
    <circle cx="60" cy="60" r="57.5" fill="#050811" stroke={`url(#${uid}-bezelGrad)`} stroke-width="2.5" />
    <circle cx="60" cy="60" r="54" fill={`url(#${uid}-vaultBg)`} />

    <!-- Clipped Interior of the Dark Vault -->
    <g clip-path={`url(#${uid}-vaultClip)`}>
      <!-- Background Dark Grid & Unilluminated Shadow Nodes (in the dark) -->
      <g opacity="0.16" stroke="#334155" stroke-width="0.7">
        <line x1="0" y1="30" x2="120" y2="30" />
        <line x1="0" y1="60" x2="120" y2="60" />
        <line x1="0" y1="90" x2="120" y2="90" />
        <line x1="30" y1="0" x2="30" y2="120" />
        <line x1="60" y1="0" x2="60" y2="120" />
        <line x1="90" y1="0" x2="90" y2="120" />
      </g>

      <!-- Shadow Euro & Hidden Cartel Nodes Lurking in the Unlit Darkness -->
      <g opacity="0.18" fill="#475569" font-family="IBM Plex Mono, monospace" font-weight="700">
        <circle cx="22" cy="84" r="3" />
        <circle cx="34" cy="98" r="2.5" />
        <line x1="22" y1="84" x2="34" y2="98" stroke="#475569" stroke-width="1" />
        <text x="14" y="75" font-size="9">€?</text>
        <text x="86" y="24" font-size="8">ДЗЗД</text>
      </g>

      <!-- =============================================================== -->
      <!-- ANIMATED VOLUMETRIC SEARCHLIGHT CONE CUTTING THROUGH THE DARK   -->
      <!-- =============================================================== -->
      <g class="searchlight-cone-group">
        <!-- Wide Volumetric Light Cone -->
        <polygon
          points="23,23 118,52 118,118 50,118"
          fill={`url(#${uid}-beamOuter)`}
        />
        <!-- High-Intensity Inner Core Beam -->
        <polygon
          points="23,23 114,68 98,114 66,114"
          fill={`url(#${uid}-beamCore)`}
        />
        <!-- Crisp Laser Forensic Scan Rays inside the Beam -->
        <line x1="24" y1="24" x2="112" y2="60" stroke="#fef08a" stroke-width="1" stroke-opacity="0.55" stroke-dasharray="3 3" />
        <line x1="24" y1="24" x2="60" y2="112" stroke="#38bdf8" stroke-width="1" stroke-opacity="0.5" stroke-dasharray="3 3" />
        <line class="searchlight-laser-ray" x1="24" y1="24" x2="96" y2="96" stroke="#ffffff" stroke-width="1.2" stroke-opacity="0.7" />
      </g>

      <!-- =============================================================== -->
      <!-- ILLUMINATED DIVIDENDS, EURO BARS & CARTEL NODES IN THE BEAM     -->
      <!-- =============================================================== -->
      <g class="illuminated-treasure-group">
        <!-- Illuminated Forensic Target Reticle on the Floor of the Beam -->
        <ellipse cx="78" cy="88" rx="28" ry="13" fill="#fbbf24" fill-opacity="0.14" stroke="#fbbf24" stroke-width="1" stroke-dasharray="4 2" />
        <ellipse cx="78" cy="88" rx="18" ry="8" fill="#10b981" fill-opacity="0.12" stroke="#38bdf8" stroke-width="0.8" />

        <!-- Connected Cartel / Dividend Graph Edges Exposed by the Light -->
        <g stroke="#fde047" stroke-width="1.3" stroke-opacity="0.85">
          <line x1="54" y1="74" x2="72" y2="60" />
          <line x1="72" y1="60" x2="94" y2="48" />
          <line x1="72" y1="60" x2="88" y2="76" />
        </g>
        <circle cx="54" cy="74" r="2.8" fill="#38bdf8" stroke="#ffffff" stroke-width="1" />
        <circle cx="72" cy="60" r="3.4" fill="#fbbf24" stroke="#ffffff" stroke-width="1" />
        <circle cx="94" cy="48" r="3.2" fill="#ef4444" stroke="#ffffff" stroke-width="1" />

        <!-- 3 Rising 3D Dividend & Public Procurement Bars -->
        <!-- Bar 1: Amber Gold -->
        <rect x="56" y="76" width="10" height="18" rx="1.8" fill={`url(#${uid}-goldBar)`} stroke="#fef08a" stroke-width="0.8" />
        <!-- Bar 2: taller Gold Bullion -->
        <rect x="70" y="66" width="10" height="28" rx="1.8" fill={`url(#${uid}-goldBar)`} stroke="#ffffff" stroke-width="0.9" />
        <!-- Bar 3: Radiant Emerald Dividend Spike -->
        <rect x="84" y="54" width="11" height="40" rx="1.8" fill={`url(#${uid}-emeraldBar)`} stroke="#a7f3d0" stroke-width="1.1" />

        <!-- Dividend Growth Trend Arrow (↗) -->
        <path
          d="M 53 73 L 71 59 L 90 45"
          fill="none"
          stroke="#ffffff"
          stroke-width="2"
          stroke-linecap="round"
        />
        <polygon points="94,42 86,43 91,50" fill="#ffffff" />

        <!-- Blazing Illuminated Euro (€) & Dividend (%) Symbols inside the Beam -->
        <g filter={`url(#${uid}-glow)`}>
          <!-- Primary Hero Euro Coin / Emblem in the Beam -->
          <circle cx="64" cy="52" r="10.5" fill="#0b1324" fill-opacity="0.85" stroke="#fbbf24" stroke-width="1.8" />
          <text
            x="64"
            y="57"
            text-anchor="middle"
            fill="#fef08a"
            font-family="IBM Plex Mono, monospace"
            font-size="15"
            font-weight="700"
          >€</text>

          <!-- Floating Dividend Yield Badge (+%) -->
          <rect x="77" y="34" width="26" height="13" rx="3.5" fill="#064e3b" stroke="#34d399" stroke-width="1.1" />
          <text
            x="90"
            y="43.5"
            text-anchor="middle"
            fill="#ecfdf5"
            font-family="IBM Plex Mono, monospace"
            font-size="8.5"
            font-weight="700"
          >+€%</text>
        </g>

        <!-- Illuminated Gold Coins / Dividend Stack Base -->
        <ellipse cx="61" cy="96" rx="7" ry="2.6" fill="#fbbf24" stroke="#fef08a" stroke-width="0.7" />
        <ellipse cx="75" cy="97" rx="7.5" ry="2.8" fill="#f59e0b" stroke="#fef08a" stroke-width="0.7" />
        <ellipse cx="89.5" cy="96" rx="8" ry="3" fill="#10b981" stroke="#a7f3d0" stroke-width="0.8" />
      </g>

      <!-- =============================================================== -->
      <!-- TACTICAL FORENSIC SEARCHLIGHT PROJECTOR TURRET (TOP-LEFT)       -->
      <!-- =============================================================== -->
      <g class="projector-turret">
        <!-- Mounting Bracket -->
        <path d="M 6 18 L 16 8 L 22 10 L 10 22 Z" fill="#334155" stroke="#94a3b8" stroke-width="0.8" />
        <!-- Projector Barrel / Housing -->
        <polygon
          points="14,10 29,15 24,30 10,24"
          fill="#1e293b"
          stroke="#fbbf24"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
        <!-- Cooling Fins on Projector -->
        <line x1="14" y1="14" x2="20" y2="11" stroke="#64748b" stroke-width="1.1" />
        <line x1="12" y1="18" x2="18" y2="15" stroke="#64748b" stroke-width="1.1" />
        <!-- Glowing Xenon / Gold Optical Lens Aperture -->
        <ellipse
          cx="25"
          cy="23"
          rx="4.5"
          ry="7.5"
          transform="rotate(-45 25 23)"
          fill="#fef08a"
          stroke="#ffffff"
          stroke-width="1.5"
          filter={`url(#${uid}-glow)`}
        />
        <!-- Lens Core Flare -->
        <circle cx="25" cy="23" r="3.2" fill="#ffffff" />
      </g>
    </g>

    <!-- Outer Compass / Forensic Reticle Ticks -->
    <g stroke="#fbbf24" stroke-width="1.5" opacity="0.8">
      <line x1="60" y1="1" x2="60" y2="6" />
      <line x1="60" y1="114" x2="60" y2="119" />
      <line x1="1" y1="60" x2="6" y2="60" />
      <line x1="114" y1="60" x2="119" y2="60" />
    </g>
  </svg>
</div>
