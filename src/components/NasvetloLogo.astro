        <rect x="2" y="37" width="13" height="22" rx="2.5" />
        <!-- Cooling Ribs / Barrel -->
        <rect x="17" y="33" width="4" height="30" rx="1" />
        <rect x="23" y="33" width="4" height="30" rx="1" />
        <!-- Main Projector Cone Head -->
        <path d="M 29 31 L 46 24 C 48 23 50 24.5 50 26.8 L 50 69.2 C 50 71.5 48 73 46 72 L 29 65 Z" />
