---
interface Props {
  variant?: 'header' | 'hero';
}
const { variant = 'header' } = Astro.props;
---
{variant === 'header' ? (
  <div class="sigma-projector-brand" title="НА СВЕТЛО · СИГМА 3.0 — Платформа за прозрачност на обществените поръчки">
    <!-- Exact sigma.midt.bg logo.svg architecture with the magnifying glass replaced by a Projector illuminating the 19 horizontal scan-lines of Bulgaria -->
    <svg
      class="sigma-projector-logo-svg"
      viewBox="0 0 545 115"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="СИГМА 3.0 · НА СВЕТЛО — Прожектор, осветяващ България"
    >
      <defs>
        <linearGradient id="hdrBeamFill" x1="0%" y1="50%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="#ac1b18" stop-opacity="0.28" />
          <stop offset="65%" stop-color="#ac1b18" stop-opacity="0.10" />
          <stop offset="100%" stop-color="#ac1b18" stop-opacity="0.0" />
        </linearGradient>
      </defs>

      <!-- Conical Light Beam from the Projector Illuminating Bulgaria -->
      <polygon points="48,37 144,10 144,86 48,59" fill="url(#hdrBeamFill)" />
