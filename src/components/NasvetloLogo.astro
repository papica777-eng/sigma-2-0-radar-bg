---
interface Props {
  variant?: 'header' | 'hero';
}
const { variant = 'header' } = Astro.props;
---
{variant === 'header' ? (
  <div class="nasvetlo-official-header" title="NAsvetlo · СИГМА 3.0 — Платформа за прозрачност на обществените поръчки">
    <img
      src="sigma3/nasvetlo-official-logo.jpg"
      alt="NAsvetlo"
      width="44"
      height="44"
      class="nasvetlo-header-img"
    />
    <div class="nasvetlo-header-text">
      <div class="nasvetlo-header-row">
        <span class="nasvetlo-brand-name">NAsvetlo</span>
        <span class="sigma-edition-tag">СИГМА 3.0</span>
      </div>
      <span class="nasvetlo-brand-tagline">Платформа за прозрачност на обществените поръчки</span>
    </div>
  </div>
) : (
  <div class="hero-official-logo-wrap">
    <img
      src="sigma3/nasvetlo-official-logo.jpg"
      alt="NAsvetlo — Прожектор върху обществените поръчки в България"
      width="320"
      height="320"
      class="hero-official-logo"
    />
  </div>
)}
