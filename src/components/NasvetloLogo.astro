---
interface Props {
  href?: string;
}
const { href = '#top' } = Astro.props;
---
<a href={href} class="brand-logo" aria-label="NAsvetlo — Граждански одит · CC-BY 4.0">
  <img
    src="/logo-icon-76.webp"
    alt=""
    aria-hidden="true"
    width="38"
    height="38"
    decoding="async"
    class="brand-logo-icon"
  />
  <div class="brand-logo-text">
    <span class="brand-logo-name">NAsvetlo</span>
    <span class="brand-logo-meta">Граждански одит · CC-BY 4.0</span>
  </div>
</a>
